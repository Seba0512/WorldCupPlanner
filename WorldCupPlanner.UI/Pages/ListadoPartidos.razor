@page "/partidos"
@using WorldCupPlanner.Servicios
@using WorldCupPlanner.Dominio.Entidades
@using WorldCupPlanner.Dominio.Enumeraciones
@inject EstadoTorneo EstadoTorneo

<PageTitle>Listado de Partidos</PageTitle>
<h1>Listado de Partidos</h1>

<p>Partidos fixture: @(EstadoTorneo.Fixture?.Partidos.Count ?? 0)</p>
<p>Partidos eliminatorios: @EstadoTorneo.PartidosEliminatorios.Count</p>

@if (EstadoTorneo.Fixture == null)
{
    <div class="alert alert-info">No hay partidos disponibles.</div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-3">
            <label>Fecha</label>
            <input type="date" class="form-control" @bind="filtroFecha" />
        </div>
        <div class="col-md-3">
            <label>Estadio</label>
            <select class="form-control" @bind="filtroEstadio">
                <option value="">Todos</option>
                @foreach (var nombre in EstadiosDisponibles)
                {
                    <option value="@nombre">@nombre</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>Grupo</label>
            <select class="form-control" @bind="filtroGrupo">
                <option value="">Todos</option>
                @foreach (var etiqueta in GruposDisponibles)
                {
                    <option value="@etiqueta">@etiqueta</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>Fase</label>
            <select class="form-control" @bind="filtroFase">
                <option value="">Todas</option>
                @foreach (var fase in FasesDisponibles)
                {
                    <option value="@fase">@MostrarFase(fase)</option>
                }
            </select>
        </div>
    </div>

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Equipo Local</th>
                <th>Equipo Visitante</th>
                <th>Estadio</th>
                <th>Grupo</th>
                <th>Fase</th>
                <th>Resultado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var partido in PartidosFiltrados)
            {
                <tr>
                    <td>@partido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@partido.EquipoLocal?.Nombre</td>
                    <td>@partido.EquipoVisitante?.Nombre</td>
                    <td>@partido.Estadio?.Nombre</td>
                    <td>@(partido.Grupo?.Etiqueta ?? "-")</td>
                    <td>@MostrarFase(partido.Fase)</td>
                    <td>@(partido.EstaJugado() ? $"{partido.GolesLocal} - {partido.GolesVisitante}" : "-")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!PartidosFiltrados.Any())
    {
        <p class="text-muted">No hay partidos que coincidan con los filtros seleccionados.</p>
    }
}

@code {
    private DateTime? filtroFecha;
    private string filtroEstadio = string.Empty;
    private string filtroGrupo = string.Empty;
    private string filtroFase = string.Empty;

    private IEnumerable<Partido> TodosLosPartidos =>
        (EstadoTorneo.Fixture?.Partidos ?? Enumerable.Empty<Partido>())
        .Concat(EstadoTorneo.PartidosEliminatorios)
        .OrderBy(p => p.Fecha);

    private IEnumerable<Partido> PartidosFiltrados =>
        TodosLosPartidos
            .Where(p => filtroFecha == null || p.Fecha.Date == filtroFecha.Value.Date)
            .Where(p => string.IsNullOrEmpty(filtroEstadio) || p.Estadio?.Nombre == filtroEstadio)
            .Where(p => string.IsNullOrEmpty(filtroGrupo) || p.Grupo?.Etiqueta == filtroGrupo)
            .Where(p => string.IsNullOrEmpty(filtroFase) || p.Fase.ToString() == filtroFase);

    private IEnumerable<string> EstadiosDisponibles =>
        TodosLosPartidos
            .Select(p => p.Estadio?.Nombre)
            .Where(n => n != null)
            .Distinct()
            .OrderBy(n => n)!;

    private IEnumerable<string> GruposDisponibles =>
        TodosLosPartidos
            .Select(p => p.Grupo?.Etiqueta)
            .Where(e => e != null)
            .Distinct()
            .OrderBy(e => e)!;

    private IEnumerable<FaseTorneo> FasesDisponibles =>
        TodosLosPartidos
            .Select(p => p.Fase)
            .Distinct()
            .OrderBy(f => (int)f);

    private static string MostrarFase(FaseTorneo fase) => fase switch
    {
        FaseTorneo.FaseDeGrupos => "Fase de Grupos",
        FaseTorneo.PrimeraRondaEliminatoria => "Primera Ronda",
        FaseTorneo.Octavos => "Octavos de Final",
        FaseTorneo.Cuartos => "Cuartos de Final",
        FaseTorneo.Semifinal => "Semifinal",
        FaseTorneo.TercerPuesto => "Tercer Puesto",
        FaseTorneo.Final => "Final",
        _ => fase.ToString()
    };
}