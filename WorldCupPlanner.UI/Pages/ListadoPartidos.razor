@page "/partidos"
@inject EstadoTorneo EstadoTorneo

<PageTitle>Partidos — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Partidos" Subtitulo="@($"{PartidosFiltrados.Count()} partidos encontrados")" />

@if (EstadoTorneo.Fixture == null)
{
    <div class="empty-state">
        <div class="empty-state-icon">📅</div>
        <div class="empty-state-title">No hay partidos disponibles</div>
        <div class="empty-state-text">Generá el fixture primero para ver los partidos.</div>
        <a href="/fixture" class="btn btn-primary">
            <span class="oi oi-globe" aria-hidden="true"></span> Ir al Fixture
        </a>
    </div>
}
else
{
    <!-- Filtros -->
    <div class="filter-bar">
        <div class="filter-group">
            <span class="filter-label">Fecha</span>
            <input type="date" class="form-control" @bind="_filtroFecha" />
        </div>
        <div class="filter-group">
            <span class="filter-label">Estadio</span>
            <select class="form-select" @bind="_filtroEstadio">
                <option value="">Todos</option>
                @foreach (var n in EstadiosDisponibles)
                {
                    <option value="@n">@n</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <span class="filter-label">Grupo</span>
            <select class="form-select" @bind="_filtroGrupo">
                <option value="">Todos</option>
                @foreach (var e in GruposDisponibles)
                {
                    <option value="@e">Grupo @e</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <span class="filter-label">Fase</span>
            <select class="form-select" @bind="_filtroFase">
                <option value="">Todas</option>
                @foreach (var f in FasesDisponibles)
                {
                    <option value="@f">@MostrarFase(f)</option>
                }
            </select>
        </div>
        <div class="filter-group" style="justify-content:flex-end; min-width:auto">
            <button class="btn btn-secondary btn-sm" @onclick="LimpiarFiltros">
                <span class="oi oi-x" aria-hidden="true"></span> Limpiar
            </button>
        </div>
    </div>

    <!-- Tabla -->
    <div class="table-card">
        @if (!PartidosFiltrados.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">🔍</div>
                <div class="empty-state-title">Sin resultados</div>
                <div class="empty-state-text">Ningún partido coincide con los filtros aplicados.</div>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Local</th>
                        <th>Result.</th>
                        <th>Visitante</th>
                        <th>Estadio</th>
                        <th>Fase</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var partido in PartidosFiltrados)
                    {
                        <tr>
                            <td style="white-space:nowrap; color:var(--text-secondary)">
                                @partido.Fecha.ToString("dd/MM/yy HH:mm")
                            </td>
                            <td style="font-weight:600">
                                @partido.EquipoLocal?.Nombre
                            </td>
                            <td style="text-align:center; font-family:var(--font-heading); font-weight:700; white-space:nowrap">
                                @if (partido.EstaJugado())
                                {
                                    <span>@partido.GolesLocal — @partido.GolesVisitante</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted)">vs</span>
                                }
                            </td>
                            <td style="font-weight:600">@partido.EquipoVisitante?.Nombre</td>
                            <td style="color:var(--text-secondary)">@partido.Estadio?.Nombre</td>
                            <td>
                                @if (partido.Grupo != null)
                                {
                                    <span class="badge badge-muted">Grupo @partido.Grupo.Etiqueta</span>
                                }
                                else
                                {
                                    <span class="badge badge-blue">@MostrarFase(partido.Fase)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private DateTime? _filtroFecha;
    private string _filtroEstadio = string.Empty;
    private string _filtroGrupo = string.Empty;
    private string _filtroFase = string.Empty;

    private IEnumerable<Partido> TodosLosPartidos =>
        (EstadoTorneo.Fixture?.Partidos ?? Enumerable.Empty<Partido>())
        .Concat(EstadoTorneo.PartidosEliminatorios)
        .OrderBy(p => p.Fecha);

    private IEnumerable<Partido> PartidosFiltrados =>
        TodosLosPartidos
            .Where(p => _filtroFecha == null || p.Fecha.Date == _filtroFecha.Value.Date)
            .Where(p => string.IsNullOrEmpty(_filtroEstadio) || p.Estadio?.Nombre == _filtroEstadio)
            .Where(p => string.IsNullOrEmpty(_filtroGrupo) || p.Grupo?.Etiqueta == _filtroGrupo)
            .Where(p => string.IsNullOrEmpty(_filtroFase) || p.Fase.ToString() == _filtroFase);

    private IEnumerable<string> EstadiosDisponibles =>
        TodosLosPartidos.Select(p => p.Estadio?.Nombre).Where(n => n != null).Distinct().OrderBy(n => n)!;

    private IEnumerable<string> GruposDisponibles =>
        TodosLosPartidos.Select(p => p.Grupo?.Etiqueta).Where(e => e != null).Distinct().OrderBy(e => e)!;

    private IEnumerable<FaseTorneo> FasesDisponibles =>
        TodosLosPartidos.Select(p => p.Fase).Distinct().OrderBy(f => (int)f);

    private void LimpiarFiltros()
    {
        _filtroFecha = null;
        _filtroEstadio = string.Empty;
        _filtroGrupo = string.Empty;
        _filtroFase = string.Empty;
    }

    private static string MostrarFase(FaseTorneo fase) => fase switch
    {
        FaseTorneo.FaseDeGrupos              => "Fase de Grupos",
        FaseTorneo.PrimeraRondaEliminatoria  => "Primera Ronda",
        FaseTorneo.Octavos   => "Octavos",
        FaseTorneo.Cuartos   => "Cuartos",
        FaseTorneo.Semifinal => "Semifinal",
        FaseTorneo.TercerPuesto => "3° Puesto",
        FaseTorneo.Final     => "Final",
        _                    => fase.ToString()
    };
}
