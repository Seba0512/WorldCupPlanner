<PageTitle>Torneo anterior â€” WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Torneo anterior" Subtitulo="Torneo anterior â€” solo lectura" UrlVolver="/fixture" TextoVolver="Volver al fixture" />

@if (FixtureAnteriorDTO == null)
{
    <div class="empty-state">
        <div class="empty-state-icon">ðŸ“‹</div>
