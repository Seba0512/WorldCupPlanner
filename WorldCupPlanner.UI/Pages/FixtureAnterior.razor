            <span style="font-size:22px; line-height:1; flex-shrink:0;">ðŸ†</span>
            <span>CampeÃ³n del torneo: <strong>@Campeon.Nombre</strong></span>
        </div>
    }

    <div style="display:flex; align-items:center; gap:10px; margin-bottom:22px; flex-wrap:wrap;">
