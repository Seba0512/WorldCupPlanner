@code {
    private string _grupoActivo = "A";
    private FaseTorneo _etapaActiva = FaseTorneo.FaseDeGrupos;

    private static readonly List<EtapasTorneoHelper.EtapaTorneo> EtapasDisponibles =
        EtapasTorneoHelper.EtapasDisponibles;

    private FixtureDTO? FixtureAnteriorDTO =>
        ControladorFixture.ObtenerFixtureAnteriorDTO(EstadoTorneo);

    private List<GrupoDTO> GruposFixtureAnterior =>
        ControladorFixture.ObtenerGruposAnterioresDTO(EstadoTorneo);

    private Grupo? GrupoSeleccionado =>
        EstadoTorneo.FixtureAnterior?.Grupos.FirstOrDefault(g => g.Etiqueta == _grupoActivo);

    private GrupoDTO? GrupoSeleccionadoDTO =>
        ControladorFixture.ObtenerGrupoAnteriorDTO(EstadoTorneo, _grupoActivo);

    private IEnumerable<PosicionEquipoDTO> TablaGrupoSeleccionado =>
        GrupoSeleccionado == null
            ? Enumerable.Empty<PosicionEquipoDTO>()
            : ControladorClasificacion.CalcularTablaDTO(GrupoSeleccionado);

    private string EtapaActivaEtiqueta =>
        EtapasDisponibles.FirstOrDefault(e => e.Fase == _etapaActiva)?.Etiqueta ?? string.Empty;

    private List<PartidoDTO> PartidosEtapaActivaDTO =>
        ControladorFixture.ObtenerPartidosEliminatoriosAnterioresPorFaseDTO(EstadoTorneo, _etapaActiva);

    private PartidoDTO? PartidoFinalAnteriorDTO =>
        ControladorFixture.ObtenerFinalAnteriorDTO(EstadoTorneo);

    private PartidoDTO? PartidoTercerPuestoAnteriorDTO =>
        ControladorFixture.ObtenerTercerPuestoAnteriorDTO(EstadoTorneo);

    private Partido? PartidoFinalAnterior =>
        EstadoTorneo.PartidosEliminatoriosAnteriores.FirstOrDefault(p => p.Fase == FaseTorneo.Final);

    private EquipoDTO? Campeon => ControladorClasificacion.ObtenerCampeonDTO(PartidoFinalAnterior);

    private void SeleccionarEtapa(FaseTorneo fase)
    {
        _etapaActiva = fase;
    }

}
