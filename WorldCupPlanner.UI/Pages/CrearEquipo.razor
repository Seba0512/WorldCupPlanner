@page "/equipos/crear"
@inject ServicioEquipo ServicioEquipo
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Nuevo equipo — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Nuevo equipo" UrlVolver="/equipos" TextoVolver="Volver a equipos" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
        </div>
    }

    <div class="form-group">
        <label class="form-label">Nombre del equipo</label>
        <input type="text" class="form-control" @bind="_equipo.Nombre" placeholder="Ej: Argentina" maxlength="60" />
        <span class="form-hint">1–60 caracteres. Debe ser único en el sistema.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Confederación</label>
        <select class="form-select" @bind="_equipo.Confederacion">
            <option value="">— Seleccioná una confederación —</option>
            @foreach (var conf in Enum.GetValues<Confederacion>())
            {
                <option value="@conf">@conf — cupo @ObtenerCupo(conf)</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label class="form-label">Puntos FIFA</label>
        <input type="number" class="form-control" @bind="_equipo.RankingFIFA" min="300" max="2500" placeholder="Ej: 1580" />
        <span class="form-hint">Valor entre 300 y 2500.</span>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar
        </button>
        <a href="/equipos" class="btn btn-secondary">Cancelar</a>
    </div>
</div>

@code {
    private Equipo _equipo = new();
    private string _error = string.Empty;

    private static readonly Dictionary<Confederacion, int> Cupos = new()
    {
        { Confederacion.UEFA, 16 }, { Confederacion.CAF, 9 },
        { Confederacion.CONCACAF, 7 }, { Confederacion.CONMEBOL, 7 },
        { Confederacion.AFC, 8 }, { Confederacion.OFC, 1 }
    };

    protected override void OnInitialized()
    {
        if (!SesionServicio.EsAdministrador) NavigationManager.NavigateTo("/");
    }

    private int ObtenerCupo(Confederacion conf) => Cupos.GetValueOrDefault(conf, 0);

    private void Guardar()
    {
        _error = string.Empty;
        try
        {
            ServicioEquipo.Agregar(_equipo, SesionServicio.UsuarioActual);
            Toast.Exito($"Equipo \"{_equipo.Nombre}\" creado correctamente.");
            NavigationManager.NavigateTo("/equipos");
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
