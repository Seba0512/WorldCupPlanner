@page "/equipos/crear"
@using WorldCupPlanner.Controladores
@using WorldCupPlanner.Dominio.DTO
@using WorldCupPlanner.Servicios
@inject ControladorEquipo ControladorEquipo
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast
@inject IDescargadorContenido DescargadorContenido

<GuardiaAdmin>
<PageTitle>Nuevo equipo — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Nuevo equipo" UrlVolver="/equipos" TextoVolver="Volver a equipos" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
            @if (_erroresCampos.Count > 0)
            {
                <ul class="mb-0 mt-1">
                    @foreach (var item in _erroresCampos)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </div>
    }

    <div class="form-group">
        <label class="form-label">Nombre del equipo <span style="color:red">*</span></label>
        <input type="text" class="form-control" @bind="_dto.Nombre" placeholder="Ej: Argentina" maxlength="60" />
        <span class="form-hint">1–60 caracteres. Debe ser único en el sistema.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Confederación <span style="color:red">*</span></label>
        <select class="form-select" @bind="_dto.Confederacion">
            <option value="">— Seleccioná una confederación —</option>
            @foreach (var conf in Enum.GetValues<Confederacion>())
            {
                <option value="@conf">@conf — cupo @ObtenerCupo(conf)</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label class="form-label">Puntos FIFA <span style="color:red">*</span></label>
        <input type="number" class="form-control" @bind="_dto.RankingFIFA" min="300" max="2500" placeholder="Ej: 1580" />
        <span class="form-hint">Valor entre 300 y 2500.</span>
    </div>

    <div class="mb-3">
        <label class="form-label">Bandera del país</label>
        @if (!string.IsNullOrEmpty(_dto.Bandera))
        {
            <div style="margin-bottom:8px">
                <img src="@_dto.Bandera" alt="Bandera" style="height:40px; border-radius:4px;" />
            </div>
        }
        <InputFile OnChange="CargarBandera" accept="image/svg+xml" class="form-control" />
        <span class="form-hint">Archivo SVG, o ingresá una URL SVG o valor Base64:</span>
        <div class="input-group mt-1">
            <input type="text" class="form-control" @bind="_urlOBase64"
                   placeholder="https://... o Base64 puro o data:image/svg+xml;base64,..." />
            <button type="button" class="btn btn-outline-secondary" @onclick="NormalizarBanderaDesdeTexto">Cargar</button>
        </div>
        @if (!string.IsNullOrEmpty(_errorBandera))
        {
            <div class="text-danger small mt-1">@_errorBandera</div>
        }
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar
        </button>
        <a href="/equipos" class="btn btn-secondary">Cancelar</a>
    </div>
</div>
</GuardiaAdmin>

@code {
    private EquipoDTO _dto = new();
    private string _error = string.Empty;
    private string _errorBandera = string.Empty;
    private string _urlOBase64 = string.Empty;
    private List<string> _erroresCampos = [];

    private int ObtenerCupo(Confederacion conf) =>
        ControladorEquipo.ObtenerCuposMaximos().GetValueOrDefault(conf, 0);

    private async Task CargarBandera(InputFileChangeEventArgs e)
    {
        try
        {
            _dto.Bandera = await ArchivoHelper.ConvertirABase64DataUri(e.File);
            _error = string.Empty;
            _errorBandera = string.Empty;
        }
        catch (ArgumentException ex) { _error = ex.Message; }
    }

    private async Task NormalizarBanderaDesdeTexto()
    {
        if (string.IsNullOrWhiteSpace(_urlOBase64)) return;
        try
        {
            _dto.Bandera = await Task.Run(() =>
                NormalizadorBanderaCsv.Normalizar(_urlOBase64.Trim(), DescargadorContenido));
            _urlOBase64 = string.Empty;
            _errorBandera = string.Empty;
        }
        catch (Exception ex) { _errorBandera = ex.Message; }
    }

    private void Guardar()
    {
        _error = string.Empty;
        _erroresCampos = [];

        var camposInvalidos = ValidarCampos();
        if (camposInvalidos.Count == 1)
        {
            _error = MensajeLargoParaCampo(camposInvalidos[0]);
            return;
        }
        if (camposInvalidos.Count > 1)
        {
            _error = "No se pudo guardar el equipo. Por favor, revisá los siguientes campos:";
            _erroresCampos = camposInvalidos.Select(MensajeCortoParaCampo).ToList();
            return;
        }

        try
        {
            ControladorEquipo.Crear(_dto, SesionServicio.UsuarioActual);
            Toast.Exito($"Equipo \"{_dto.Nombre}\" creado correctamente.");
            NavigationManager.NavigateTo("/equipos");
        }
        catch (Exception ex) { _error = MensajeErrorHelper.ParaUsuario(ex); }
    }

    private List<string> ValidarCampos()
    {
        var errores = new List<string>();
        if (string.IsNullOrWhiteSpace(_dto.Nombre))
            errores.Add("nombre");
        if (_dto.Confederacion == null)
            errores.Add("confederacion");
        if (_dto.RankingFIFA < 300 || _dto.RankingFIFA > 2500)
            errores.Add("ranking");
        return errores;
    }

    private static string MensajeLargoParaCampo(string campo) => campo switch
    {
        "nombre"        => "El nombre del equipo es obligatorio. Por favor, ingresá un nombre antes de guardar.",
        "confederacion" => "Debés seleccionar una confederación para el equipo antes de guardar.",
        "ranking"       => "Los puntos FIFA deben estar entre 300 y 2500. Por favor, ingresá un valor válido.",
        _               => "El equipo no es válido."
    };

    private static string MensajeCortoParaCampo(string campo) => campo switch
    {
        "nombre"        => "El nombre del equipo es obligatorio.",
        "confederacion" => "Debés seleccionar una confederación.",
        "ranking"       => "Los puntos FIFA deben estar entre 300 y 2500.",
        _               => "Campo inválido."
    };
}
