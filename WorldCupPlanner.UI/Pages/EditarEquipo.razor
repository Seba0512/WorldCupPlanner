@page "/equipos/{Nombre}/editar"
@inject ServicioEquipo ServicioEquipo
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Editar equipo — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Editar equipo" UrlVolver="/equipos" TextoVolver="Volver a equipos" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
        </div>
    }

    <div class="form-group">
        <label class="form-label">Nombre del equipo</label>
        <input type="text" class="form-control" @bind="_equipo.Nombre" maxlength="60" />
        <span class="form-hint">1–60 caracteres. Debe ser único en el sistema.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Confederación</label>
        <select class="form-select" @bind="_equipo.Confederacion">
            @foreach (var conf in Enum.GetValues<Confederacion>())
            {
                <option value="@conf">@conf</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label class="form-label">Puntos FIFA</label>
        <input type="number" class="form-control" @bind="_equipo.RankingFIFA" min="300" max="2500" />
        <span class="form-hint">Valor entre 300 y 2500.</span>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar cambios
        </button>
        <a href="/equipos" class="btn btn-secondary">Cancelar</a>
    </div>
</div>

@code {
    [Parameter] public string Nombre { get; set; } = string.Empty;
    private Equipo _equipo = new();
    private string _error = string.Empty;

    protected override void OnInitialized()
    {
        if (!SesionServicio.EsAdministrador) { NavigationManager.NavigateTo("/"); return; }
        var original = ServicioEquipo.Buscar(e => e.Nombre == Nombre).First();
        _equipo = new Equipo { Id = original.Id, Nombre = original.Nombre, Confederacion = original.Confederacion, RankingFIFA = original.RankingFIFA };
    }

    private void Guardar()
    {
        _error = string.Empty;
        try
        {
            ServicioEquipo.EditarEquipo(_equipo, Nombre, SesionServicio.UsuarioActual);
            Toast.Exito($"Equipo actualizado correctamente.");
            NavigationManager.NavigateTo("/equipos");
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
