@page "/equipos/{Nombre}/editar"
@using WorldCupPlanner.Controladores
@using WorldCupPlanner.Dominio.DTO
@inject ControladorEquipo ControladorEquipo
@inject EstadoTorneo EstadoTorneo
@inject ControladorConsultasTorneo ControladorConsultasTorneo
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<GuardiaAdmin>
<PageTitle>Editar equipo — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Editar equipo" UrlVolver="/equipos" TextoVolver="Volver a equipos" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
            @if (_erroresCampos.Count > 0)
            {
                <ul class="mb-0 mt-1">
                    @foreach (var item in _erroresCampos)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </div>
    }
    @if (_edicionBloqueada)
    {
        <div class="alert alert-warning">
            <span class="oi oi-warning" aria-hidden="true"></span>
            No se puede editar un equipo que participa en el fixture generado.
        </div>
    }

    <div class="form-group">
        <label class="form-label">Nombre del equipo <span style="color:red">*</span></label>
        <input type="text" class="form-control" @bind="_equipo.Nombre" maxlength="60" disabled="@_edicionBloqueada" />
        <span class="form-hint">1–60 caracteres. Debe ser único en el sistema.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Confederación <span style="color:red">*</span></label>
        <select class="form-select" @bind="_equipo.Confederacion" disabled="@_edicionBloqueada">
            @foreach (var conf in Enum.GetValues<Confederacion>())
            {
                <option value="@conf">@conf</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label class="form-label">Puntos FIFA <span style="color:red">*</span></label>
        <input type="number" class="form-control" @bind="_equipo.RankingFIFA" min="300" max="2500" disabled="@_edicionBloqueada" />
        <span class="form-hint">Valor entre 300 y 2500.</span>
    </div>

    <div class="mb-3">
        <label class="form-label">Bandera del país</label>
        @if (!string.IsNullOrEmpty(_equipo.Bandera))
        {
            <div style="margin-bottom:8px">
                <img src="@_equipo.Bandera" alt="Bandera" style="height:40px; border-radius:4px;" />
            </div>
        }
        <InputFile OnChange="CargarBandera" accept="image/*" class="form-control" disabled="@_edicionBloqueada" />
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@_edicionBloqueada">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar cambios
        </button>
        <a href="/equipos" class="btn btn-secondary">Cancelar</a>
    </div>
</div>
</GuardiaAdmin>

@code {
    [Parameter] public string Nombre { get; set; } = string.Empty;
    private EquipoDTO _equipo = new();
    private string _error = string.Empty;
    private List<string> _erroresCampos = [];
    private bool _edicionBloqueada;

    protected override void OnInitialized()
    {
        _equipo = ControladorEquipo.ObtenerParaEdicionDTO(Nombre);
        _edicionBloqueada = ControladorConsultasTorneo.EquipoParticipaEnFixture(EstadoTorneo, _equipo);
    }

    private async Task CargarBandera(InputFileChangeEventArgs e)
    {
        _equipo.Bandera = await ArchivoHelper.ConvertirABase64DataUri(e.File);
    }

    private void Guardar()
    {
        _error = string.Empty;
        _erroresCampos = [];

        if (_edicionBloqueada)
        {
            _error = "No se puede editar un equipo que participa en el fixture generado.";
            return;
        }

        var camposInvalidos = ValidarCampos();
        if (camposInvalidos.Count == 1)
        {
            _error = MensajeLargoParaCampo(camposInvalidos[0]);
            return;
        }
        if (camposInvalidos.Count > 1)
        {
            _error = "No se pudo guardar el equipo. Por favor, revisá los siguientes campos:";
            _erroresCampos = camposInvalidos.Select(MensajeCortoParaCampo).ToList();
            return;
        }

        try
        {
            if (_edicionBloqueada)
                throw new InvalidOperationException("No se puede editar un equipo que participa en el fixture generado.");

            ControladorEquipo.Actualizar(_equipo, Nombre, SesionServicio.UsuarioActual);
            Toast.Exito($"Equipo actualizado correctamente.");
            NavigationManager.NavigateTo("/equipos");
        }
        catch (Exception ex) { _error = MensajeErrorHelper.ParaUsuario(ex); }
    }

    private List<string> ValidarCampos()
    {
        var errores = new List<string>();
        if (string.IsNullOrWhiteSpace(_equipo.Nombre))
            errores.Add("nombre");
        if (_equipo.RankingFIFA < 300 || _equipo.RankingFIFA > 2500)
            errores.Add("ranking");
        return errores;
    }

    private static string MensajeLargoParaCampo(string campo) => campo switch
    {
        "nombre"  => "El nombre del equipo es obligatorio. Por favor, ingresá un nombre antes de guardar.",
        "ranking" => "Los puntos FIFA deben estar entre 300 y 2500. Por favor, ingresá un valor válido.",
        _         => "El equipo no es válido."
    };

    private static string MensajeCortoParaCampo(string campo) => campo switch
    {
        "nombre"  => "El nombre del equipo es obligatorio.",
        "ranking" => "Los puntos FIFA deben estar entre 300 y 2500.",
        _         => "Campo inválido."
    };

}
