@page "/fixture"
@inject ServicioFixture ServicioFixture
@inject ServicioEstadio ServicioEstadio
@inject ServicioClasificacion ServicioClasificacion
@inject ServicioCruces ServicioCruces
@inject EstadoTorneo EstadoTorneo
@inject ServicioSimulacion ServicioSimulacion
@inject ServicioConfiguracionTorneo ServicioConfiguracionTorneo
@inject ConfiguracionTorneo ConfiguracionTorneo
@inject SesionServicio SesionServicio
@inject ToastServicio Toast

<PageTitle>Fixture — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Fixture" Subtitulo="Fase de grupos y cruces eliminatorios">
    <AccionesContent>
        @if (EstadoTorneo.Fixture != null)
        {
            <button class="btn btn-warning btn-sm" @onclick="SimularResultados">
                <span class="oi oi-cog" aria-hidden="true"></span> Simular resultados
            </button>
        }
    </AccionesContent>
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        <span class="oi oi-warning" aria-hidden="true"></span> @_error
    </div>
}

@if (EstadoTorneo.Fixture == null)
{
    <!-- Sin fixture -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="glass-card" style="padding:32px; text-align:center;">
                <div style="font-size:48px; margin-bottom:16px">⚽</div>
                <h3 style="font-family:var(--font-heading); font-size:20px; font-weight:700; margin-bottom:8px">
                    Fase de Grupos
                </h3>
                <p style="font-size:14px; color:var(--text-secondary); margin-bottom:20px; line-height:1.6">
                    Generá el fixture completo de la fase de grupos. Necesitás 48 equipos y al menos 4 estadios.
                </p>
                <div class="form-group" style="text-align:left; margin-bottom:16px">
                    <label class="form-label">Semilla del fixture</label>
                    <input type="number" class="form-control" @bind="ConfiguracionTorneo.SemillaFixture" />
                    <span class="form-hint">Determina el orden de los bombos.</span>
                </div>
                <button type="button" class="btn btn-primary w-100" @onclick="GenerarFixture">
                    <span class="oi oi-cog" aria-hidden="true"></span> Generar Fixture
                </button>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="table-card" style="height:100%">
                <div class="table-card-header"><span class="table-card-title">¿Cómo funciona?</span></div>
                <div style="padding:20px;">
                    <div style="display:flex; gap:12px; margin-bottom:14px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">1</span>
                        <span style="font-size:13px; color:var(--text-secondary)">48 equipos se dividen en 12 grupos (A–L) de 4 equipos cada uno.</span>
                    </div>
                    <div style="display:flex; gap:12px; margin-bottom:14px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">2</span>
                        <span style="font-size:13px; color:var(--text-secondary)">Cada equipo juega contra los otros 3 de su grupo (round-robin).</span>
                    </div>
                    <div style="display:flex; gap:12px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">3</span>
                        <span style="font-size:13px; color:var(--text-secondary)">Los primeros y segundos de cada grupo, más los mejores terceros, avanzan.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Fixture generado -->
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <span class="badge badge-green" style="font-size:12px; padding:5px 12px">
                <span class="oi oi-check" aria-hidden="true"></span> Fixture generado — @EstadoTorneo.Fixture.Partidos.Count partidos
            </span>
        </div>
    </div>

    <!-- Tabs de grupos -->
    <div class="group-tabs">
        @foreach (var grupo in EstadoTorneo.Fixture.Grupos)
        {
            <button class="group-tab @(_grupoActivo == grupo.Etiqueta ? "active" : "")"
                    @onclick="() => _grupoActivo = grupo.Etiqueta">
                Grupo @grupo.Etiqueta
            </button>
        }
    </div>

    <!-- Partidos del grupo activo -->
    @if (GrupoSeleccionado != null)
    {
        <div class="table-card mb-4">
            <div class="table-card-header">
                <span class="table-card-title">Grupo @GrupoSeleccionado.Etiqueta</span>
                <span style="font-size:12px; color:var(--text-secondary)">@GrupoSeleccionado.Partidos.Count partidos</span>
            </div>
            @foreach (var partido in GrupoSeleccionado.Partidos)
            {
                <div class="match-card @(partido.EstaJugado() && partido.Ganador() != null ? "match-winner" : "")">
                    <div class="match-team @(partido.EstaJugado() && partido.Ganador() == partido.EquipoLocal ? "match-winner" : "")">
                        @partido.EquipoLocal?.Nombre
                    </div>
                    <div class="match-score">
                        @if (partido.EstaJugado())
                        {
                            <span class="score-box">@partido.GolesLocal</span>
                            <span class="score-sep">—</span>
                            <span class="score-box">@partido.GolesVisitante</span>
                        }
                        else
                        {
                            <span style="font-size:12px; color:var(--text-muted)">vs</span>
                        }
                    </div>
                    <div class="match-team right @(partido.EstaJugado() && partido.Ganador() == partido.EquipoVisitante ? "match-winner" : "")">
                        @partido.EquipoVisitante?.Nombre
                    </div>
                    <div class="match-meta" style="margin-left:12px; text-align:right; min-width:110px">
                        @partido.Fecha.ToString("dd/MM/yy HH:mm")
                    </div>
                    <a href="/partidos/@partido.Id/editar" class="btn btn-success btn-sm" style="margin-left:8px; flex-shrink:0">
                        <span class="oi oi-pencil" aria-hidden="true"></span>
                    </a>
                </div>
            }
        </div>
    }

    <!-- Fase eliminatoria -->
    <div class="table-card">
        <div class="table-card-header">
            <span class="table-card-title">Fase Eliminatoria</span>
            @if (!EstadoTorneo.PartidosEliminatorios.Any())
            {
                <button class="btn btn-primary btn-sm" @onclick="GenerarCruces">
                    <span class="oi oi-cog" aria-hidden="true"></span> Generar Cruces
                </button>
            }
            else
            {
                <span class="badge badge-green">
                    @EstadoTorneo.PartidosEliminatorios.Count partidos
                </span>
            }
        </div>

        @if (!EstadoTorneo.PartidosEliminatorios.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">🏆</div>
                <div class="empty-state-title">Sin cruces eliminatorios</div>
                <div class="empty-state-text">Una vez jugada la fase de grupos, generá los cruces eliminatorios.</div>
            </div>
        }
        else
        {
            @foreach (var fase in EstadoTorneo.PartidosEliminatorios.Select(p => p.Fase).Distinct().OrderBy(f => (int)f))
            {
                <div style="padding: 12px 16px 4px; font-size:11px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--text-muted); border-top: 1px solid var(--border-subtle);">
                    @MostrarFase(fase)
                </div>
                @foreach (var partido in EstadoTorneo.PartidosEliminatorios.Where(p => p.Fase == fase))
                {
                    <div class="match-card">
                        <div class="match-team @(partido.EstaJugado() && partido.Ganador() == partido.EquipoLocal ? "match-winner" : "")">
                            @(partido.EquipoLocal?.Nombre ?? "Por definir")
                        </div>
                        <div class="match-score">
                            @if (partido.EstaJugado())
                            {
                                <span class="score-box">@partido.GolesLocal</span>
                                <span class="score-sep">—</span>
                                <span class="score-box">@partido.GolesVisitante</span>
                            }
                            else
                            {
                                <span style="font-size:12px; color:var(--text-muted)">vs</span>
                            }
                        </div>
                        <div class="match-team right @(partido.EstaJugado() && partido.Ganador() == partido.EquipoVisitante ? "match-winner" : "")">
                            @(partido.EquipoVisitante?.Nombre ?? "Por definir")
                        </div>
                        <div class="match-meta" style="margin-left:12px; min-width:110px; text-align:right">
                            @partido.Fecha.ToString("dd/MM/yy HH:mm")
                        </div>
                        <a href="/partidos/@partido.Id/editar" class="btn btn-success btn-sm" style="margin-left:8px; flex-shrink:0">
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                        </a>
                    </div>
                }
            }
        }
    </div>
}

@code {
    private string _error = string.Empty;
    private string _grupoActivo = "A";

    private Grupo? GrupoSeleccionado =>
        EstadoTorneo.Fixture?.Grupos.FirstOrDefault(g => g.Etiqueta == _grupoActivo);

    private void GenerarFixture()
    {
        _error = string.Empty;
        try
        {
            var estadios = ServicioEstadio.ObtenerEstadios();
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            EstadoTorneo.Fixture = ServicioFixture.GenerarFixture(estadios, config);
            EstadoTorneo.PartidosEliminatorios = new();
            Toast.Exito("Fixture generado correctamente.");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void SimularResultados()
    {
        _error = string.Empty;
        try
        {
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            var partidos = EstadoTorneo.Fixture!.Partidos.Concat(EstadoTorneo.PartidosEliminatorios).ToList();
            ServicioSimulacion.SimularResultados(partidos, config);
            Toast.Exito("Resultados simulados correctamente.");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void GenerarCruces()
    {
        _error = string.Empty;
        try
        {
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            var clasificados = ServicioClasificacion.ObtenerClasificadosAFaseEliminatoria(EstadoTorneo.Fixture!, config);
            var estadios = ServicioEstadio.ObtenerEstadios();
            EstadoTorneo.PartidosEliminatorios = ServicioCruces.GenerarPrimeraRondaEliminatoria(
                new ContextoSorteo { Clasificados = clasificados, Estadios = estadios, ConfiguracionTorneo = config });
            Toast.Exito("Cruces eliminatorios generados.");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string MostrarFase(FaseTorneo fase) => fase switch
    {
        FaseTorneo.PrimeraRondaEliminatoria => "Primera Ronda",
        FaseTorneo.Octavos   => "Octavos de Final",
        FaseTorneo.Cuartos   => "Cuartos de Final",
        FaseTorneo.Semifinal => "Semifinal",
        FaseTorneo.TercerPuesto => "Tercer Puesto",
        FaseTorneo.Final     => "Final",
        _                    => fase.ToString()
    };
}
