@page "/fixture"
@inject ServicioFixture ServicioFixture
@inject ServicioEstadio ServicioEstadio
@inject ServicioEquipo ServicioEquipo
@inject ServicioClasificacion ServicioClasificacion
@inject ServicioCruces ServicioCruces
@inject EstadoTorneo EstadoTorneo
@inject ServicioSimulacion ServicioSimulacion
@inject ServicioConfiguracionTorneo ServicioConfiguracionTorneo
@inject ServicioPersistenciaFixture ServicioPersistenciaFixture
@inject SesionServicio SesionServicio
@inject ToastServicio Toast
@inject NavigationManager NavigationManager

<PageTitle>Fixture — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Fixture" Subtitulo="Fase de grupos y cruces eliminatorios">
    <AccionesContent>
        @if (EstadoTorneo.Fixture != null)
        {
            @if (_etapaActiva != FaseTorneo.FaseDeGrupos)
            {
                <button class="btn btn-primary btn-sm"
                        disabled="@(FaseYaGenerada(_etapaActiva) || !PuedeGenerarFase(_etapaActiva) || _generando)"
                        @onclick="GenerarFaseActiva">
                    @if (_generando)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Generando...</span>
                    }
                    else
                    {
                        <span class="oi oi-cog" aria-hidden="true"></span>
                        <span>@(FaseYaGenerada(_etapaActiva) ? "Cruces generados" : "Generar Cruces")</span>
                    }
                </button>
            }
            <div class="btn-group btn-group-sm" role="group" aria-label="Opciones de simulación">
                @if (_etapaActiva == FaseTorneo.FaseDeGrupos)
                {
                    <select class="form-select form-select-sm"
                            style="width:auto"
                            @bind="_jornadaActiva"
                            disabled="@(!EsEtapaActivaSimulable)">
                        <option value="@JornadaUno" disabled="@(!EsJornadaSeleccionable(JornadaUno))">Jornada 1</option>
                        <option value="@JornadaDos" disabled="@(!EsJornadaSeleccionable(JornadaDos))">Jornada 2</option>
                        <option value="@JornadaTres" disabled="@(!EsJornadaSeleccionable(JornadaTres))">Jornada 3</option>
                    </select>
                }
                <button class="btn btn-warning"
                        disabled="@(!PuedeSimularJornadaOFecha())"
                        @onclick="SimularJornadaOFecha">
                    <span class="oi oi-clock" aria-hidden="true"></span>
                    @(_etapaActiva == FaseTorneo.FaseDeGrupos ? "Simular jornada" : "Simular fecha")
                </button>
                <button class="btn btn-warning"
                        disabled="@(!PuedeSimularFaseActiva())"
                        @onclick="SimularFaseActiva">
                    <span class="oi oi-cog" aria-hidden="true"></span> Simular fase
                </button>
            </div>
        }
    </AccionesContent>
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        <span class="oi oi-warning" aria-hidden="true"></span> @_error
    </div>
}

@if (!string.IsNullOrEmpty(MensajeCondicionFaseActiva))
{
    <div class="alert alert-info">
        <span class="oi oi-info" aria-hidden="true"></span> @MensajeCondicionFaseActiva
    </div>
}

@if (EstadoTorneo.Fixture == null)
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="glass-card" style="padding:32px; text-align:center;">
                <div style="font-size:48px; margin-bottom:16px">⚽</div>
                <h3 style="font-family:var(--font-heading); font-size:20px; font-weight:700; margin-bottom:8px">
                    Fase de Grupos
                </h3>
                <p style="font-size:14px; color:var(--text-secondary); margin-bottom:20px; line-height:1.6">
                    Generá el fixture completo de la fase de grupos. Necesitás exactamente 48 equipos registrados y al menos 4 estadios. Si faltan equipos, completalos primero desde la sección <strong>Equipos</strong>.
                </p>
                <div class="form-group" style="text-align:left; margin-bottom:16px">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                        <label class="form-label" style="margin:0">Configuración activa</label>
                        @if (SesionServicio.EsAdministrador)
                        {
                            <a href="/configuracion" class="btn btn-link btn-sm" style="font-size:12px; padding:0;">
                                <span class="oi oi-cog" aria-hidden="true"></span> Editar
                            </a>
                        }
                    </div>
                    @{
                        var configActual = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
                    }
                    <div style="font-size:13px; color:var(--text-secondary);">
                        Semilla: <strong>@configActual.SemillaFixture</strong> —
                        Inicio: <strong>@configActual.FechaInicioTorneo.ToString("yyyy-MM-dd")</strong> —
                        Máx. @configActual.MaxPartidosPorDia partidos/día
                    </div>
                </div>
                <button type="button" class="btn btn-primary w-100" @onclick="GenerarFixture">
                    <span class="oi oi-cog" aria-hidden="true"></span> Generar Fixture
                </button>
                @if (EstadoTorneo.FixtureAnterior != null)
                {
                    <a href="/fixture/anterior" class="btn btn-secondary w-100 mt-2">
                        <span class="oi oi-eye" aria-hidden="true"></span> Ver torneo anterior
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="table-card" style="height:100%">
                <div class="table-card-header"><span class="table-card-title">¿Cómo funciona?</span></div>
                <div style="padding:20px;">
                    <div style="display:flex; gap:12px; margin-bottom:14px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">1</span>
                        <span style="font-size:13px; color:var(--text-secondary)">48 equipos se dividen en 12 grupos (A–L) de 4 equipos cada uno.</span>
                    </div>
                    <div style="display:flex; gap:12px; margin-bottom:14px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">2</span>
                        <span style="font-size:13px; color:var(--text-secondary)">Cada equipo juega contra los otros 3 de su grupo (round-robin).</span>
                    </div>
                    <div style="display:flex; gap:12px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">3</span>
                        <span style="font-size:13px; color:var(--text-secondary)">Los primeros y segundos de cada grupo, más los mejores terceros, avanzan.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <span class="badge badge-green" style="font-size:12px; padding:5px 12px">
                <span class="oi oi-check" aria-hidden="true"></span> Fixture generado — @EstadoTorneo.Fixture.Partidos.Count partidos
            </span>
        </div>
    </div>

    @if (TorneoEstaFinalizado)
    {
        <div class="alert alert-success mb-3">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div>
                    <strong>¡Torneo finalizado!</strong>
                    — Campeón: <strong>@(PartidoFinal?.Ganador()?.Nombre)</strong>
                </div>
                <button type="button" class="btn btn-primary btn-sm" @onclick="CrearNuevoTorneo">
                    <span class="oi oi-plus" aria-hidden="true"></span> Crear nuevo torneo
                </button>
            </div>
        </div>
    }

    <div class="table-card mb-3">
        <div class="table-card-header">
            <span class="table-card-title">Configuración usada para generar el fixture</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Parámetro</th>
                    <th>Valor</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Fecha inicio torneo</td><td>@ConfiguracionUsadaParaFixture.FechaInicioTorneo.ToString("yyyy-MM-dd")</td></tr>
                <tr><td>Semilla fixture</td><td>@ConfiguracionUsadaParaFixture.SemillaFixture</td></tr>
                <tr><td>Semilla completar</td><td>@ConfiguracionUsadaParaFixture.SemillaCompletar</td></tr>
                <tr><td>Semilla cruces</td><td>@ConfiguracionUsadaParaFixture.SemillaCrucesFase</td></tr>
                <tr><td>Semilla simulacion</td><td>@ConfiguracionUsadaParaFixture.SemillaSimulation</td></tr>
                <tr><td>Max partidos por dia</td><td>@ConfiguracionUsadaParaFixture.MaxPartidosPorDia</td></tr>
                <tr><td>Separacion entre fechas (dias)</td><td>@ConfiguracionUsadaParaFixture.SeparacionEntreFechas</td></tr>
            </tbody>
        </table>
    </div>
    <div class="stage-tabs" role="tablist" aria-label="Etapas del torneo">
        @foreach (var etapa in EtapasDisponibles)
        {
            <button class="stage-tab @(_etapaActiva == etapa.Fase ? "active" : "")"
                    role="tab"
                    aria-selected="@(_etapaActiva == etapa.Fase ? "true" : "false")"
                    tabindex="@(_etapaActiva == etapa.Fase ? 0 : -1)"
                    @onclick="() => SeleccionarEtapa(etapa.Fase)"
                    @onkeydown="(e) => ManejarNavegacionTeclado(e, etapa.Fase)">
                @etapa.Etiqueta
            </button>
        }
    </div>


    
    @if (_etapaActiva == FaseTorneo.FaseDeGrupos)
    {
        <!-- Tabs de grupos -->
        <div class="group-tabs" role="tablist" aria-label="Grupos de la fase de grupos">
            @foreach (var grupo in EstadoTorneo.Fixture.Grupos)
            {
                <button class="group-tab @(_grupoActivo == grupo.Etiqueta ? "active" : "")"
                        role="tab"
                        aria-selected="@(_grupoActivo == grupo.Etiqueta ? "true" : "false")"
                        tabindex="@(_grupoActivo == grupo.Etiqueta ? 0 : -1)"
                        @onclick="() => _grupoActivo = grupo.Etiqueta">
                    Grupo @grupo.Etiqueta
                </button>
            }
        </div>

        <!-- Partidos del grupo activo -->
        @if (GrupoSeleccionado != null)
        {
            <div class="table-card mb-3">
                <div class="table-card-header">
                    <span class="table-card-title">Tabla de posiciones — Grupo @GrupoSeleccionado.Etiqueta</span>
                    <span style="font-size:12px; color:var(--text-secondary)">4 equipos</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-sm mb-0" style="font-size:13px; vertical-align:middle;">
                        <thead>
                            <tr style="color:var(--text-secondary); text-transform:uppercase; font-size:11px; letter-spacing:0.04em;">
                                <th style="width:72px;">Posición</th>
                                <th>Equipo</th>
                                <th class="text-center">PJ</th>
                                <th class="text-center">PG</th>
                                <th class="text-center">PE</th>
                                <th class="text-center">PP</th>
                                <th class="text-center">GF</th>
                                <th class="text-center">GC</th>
                                <th class="text-center">DG</th>
                                <th class="text-center">Pts</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var posicionActual = 1;
                            }
                            @foreach (var posicion in TablaGrupoSeleccionado)
                            {
                                var numeroPosicion = posicionActual++;
                                <tr style="@ObtenerEstiloFilaPosicion(numeroPosicion)">
                                    <td>
                                        <span style="font-weight:700;">@numeroPosicion</span>
                                        @if (numeroPosicion <= 2)
                                        {
                                            <span class="badge badge-green" style="margin-left:6px;">Clasifica</span>
                                        }
                                        else if (numeroPosicion == 3)
                                        {
                                            <span class="badge badge-muted" style="margin-left:6px;">3°</span>
                                        }
                                    </td>
                                    <td style="font-weight:700;">@posicion.Equipo.Nombre</td>
                                    <td class="text-center">@posicion.PartidosJugados</td>
                                    <td class="text-center">@posicion.PartidosGanados</td>
                                    <td class="text-center">@posicion.PartidosEmpatados</td>
                                    <td class="text-center">@posicion.PartidosPerdidos</td>
                                    <td class="text-center">@posicion.GolesAFavor</td>
                                    <td class="text-center">@posicion.GolesEnContra</td>
                                    <td class="text-center">@posicion.DiferenciaGoles</td>
                                    <td class="text-center" style="font-weight:800;">@posicion.Puntos</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="table-card mb-4">
                <div class="table-card-header">
                    <span class="table-card-title">Grupo @GrupoSeleccionado.Etiqueta</span>
                    <span style="font-size:12px; color:var(--text-secondary)">@GrupoSeleccionado.Partidos.Count partidos</span>
                </div>
                @foreach (var partido in GrupoSeleccionado.Partidos)
                {
                    <div class="match-card @(partido.EstaJugado() && partido.Ganador() != null ? "match-winner" : "")">
                        <div class="match-team @(partido.EstaJugado() && partido.Ganador() == partido.EquipoLocal ? "match-winner" : "")">
                            @partido.EquipoLocal?.Nombre
                        </div>
                        <div class="match-score">
                            @if (partido.EstaJugado())
                            {
                                <span class="score-box">@partido.GolesLocal</span>
                                <span class="score-sep">—</span>
                                <span class="score-box">@partido.GolesVisitante</span>
                            }
                            else
                            {
                                <span style="font-size:12px; color:var(--text-muted)">vs</span>
                            }
                        </div>
                        <div class="match-team right @(partido.EstaJugado() && partido.Ganador() == partido.EquipoVisitante ? "match-winner" : "")">
                            @partido.EquipoVisitante?.Nombre
                        </div>
                        <div class="match-meta" style="margin-left:12px; text-align:right; min-width:110px">
                            @partido.Fecha.ToString("dd/MM/yy HH:mm")
                        </div>
                        <button type="button"
                                class="btn btn-warning btn-sm"
                                disabled="@(!PuedeSimularPartido(partido))"
                                style="margin-left:8px; flex-shrink:0"
                                @onclick="() => SimularPartido(partido)">
                            Simular partido
                        </button>
                        <a href="/partidos/@partido.Id/editar" class="btn btn-success btn-sm" style="margin-left:8px; flex-shrink:0">
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                        </a>
                    </div>
                }
            </div>
        }
    }
    else if (_etapaActiva == FaseTorneo.Final)
    {
        <!-- Layout diferenciado: Final y Tercer Puesto -->
        @if (PartidoFinal == null && PartidoTercerPuesto == null)
        {
            <div class="empty-state">
                <div class="empty-state-icon">🏆</div>
                <div class="empty-state-title">Sin partidos disponibles</div>
                <div class="empty-state-text">Generá los cruces de la Final una vez que las Semifinales estén completas.</div>
            </div>
        }
        else
        {
            <!-- ── FINAL ───────────────────────────────────────── -->
            @if (PartidoFinal != null)
            {
                <div class="table-card mb-4"
                     style="border-color:rgba(244,185,66,0.35); box-shadow:var(--shadow-gold);">
                    <div class="table-card-header"
                         style="background:linear-gradient(135deg,rgba(244,185,66,0.12),rgba(244,185,66,0.04));
                                border-bottom-color:rgba(244,185,66,0.2);">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span style="font-size:22px; line-height:1">🏆</span>
                            <div>
                                <div class="table-card-title"
                                     style="color:var(--accent-gold); font-size:17px; letter-spacing:0.02em;">
                                    Gran Final
                                </div>
                                <div style="font-size:11px; color:var(--text-muted); font-weight:600;
                                            text-transform:uppercase; letter-spacing:0.08em; margin-top:2px;">
                                    World Cup 2026
                                </div>
                            </div>
                        </div>
                        <span class="badge badge-gold">Partido decisivo</span>
                    </div>

                    <div class="match-card" style="padding:28px 20px; gap:16px;">
                        <div style="flex:1; text-align:left;">
                            <div style="font-family:var(--font-heading); font-size:18px; font-weight:700;
                                        color:@(PartidoFinal.EstaJugado() && PartidoFinal.Ganador()?.Id == PartidoFinal.EquipoLocal?.Id
                                                 ? "var(--accent-gold)" : "var(--text-primary)");">
                                @(PartidoFinal.EquipoLocal?.Nombre ?? "Por definir")
                            </div>
                            @if (PartidoFinal.EstaJugado() && PartidoFinal.Ganador()?.Id == PartidoFinal.EquipoLocal?.Id)
                            {
                                <div style="font-size:10px; font-weight:700; text-transform:uppercase;
                                            letter-spacing:0.1em; color:var(--accent-gold); margin-top:4px;">
                                    🥇 Campeón
                                </div>
                                @if (PartidoFinal.FueDefinidoPorPenales())
                                {
                                    <span class="badge badge-penalty" style="margin-top:4px;">Ganador por penales</span>
                                }
                            }
                        </div>

                        <div class="match-score" style="min-width:100px; flex-direction:column; gap:4px;">
                            @if (PartidoFinal.EstaJugado())
                            {
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span class="score-box"
                                          style="font-size:32px; color:var(--accent-gold); min-width:36px;">
                                        @PartidoFinal.GolesLocal
                                    </span>
                                    <span class="score-sep" style="font-size:18px;">—</span>
                                    <span class="score-box"
                                          style="font-size:32px; color:var(--accent-gold); min-width:36px;">
                                        @PartidoFinal.GolesVisitante
                                    </span>
                                </div>
                                @if (PartidoFinal.FueDefinidoPorPenales())
                                {
                                    <span style="font-size:11px; color:rgb(251,146,60); font-weight:700;
                                                 text-transform:uppercase; letter-spacing:0.06em; text-align:center;">
                                        Penales
                                    </span>
                                }
                            }
                            else
                            {
                                <span style="font-size:13px; color:var(--text-muted); font-weight:600;
                                             letter-spacing:0.06em; text-transform:uppercase;">vs</span>
                            }
                            <div style="font-size:11px; color:var(--text-muted); white-space:nowrap;">
                                @PartidoFinal.Fecha.ToString("dd/MM/yy HH:mm")
                            </div>
                        </div>

                        <div style="flex:1; text-align:right;">
                            <div style="font-family:var(--font-heading); font-size:18px; font-weight:700;
                                        color:@(PartidoFinal.EstaJugado() && PartidoFinal.Ganador()?.Id == PartidoFinal.EquipoVisitante?.Id
                                                 ? "var(--accent-gold)" : "var(--text-primary)");">
                                @(PartidoFinal.EquipoVisitante?.Nombre ?? "Por definir")
                            </div>
                            @if (PartidoFinal.EstaJugado() && PartidoFinal.Ganador()?.Id == PartidoFinal.EquipoVisitante?.Id)
                            {
                                <div style="font-size:10px; font-weight:700; text-transform:uppercase;
                                            letter-spacing:0.1em; color:var(--accent-gold); margin-top:4px;">
                                    🥇 Campeón
                                </div>
                                @if (PartidoFinal.FueDefinidoPorPenales())
                                {
                                    <span class="badge badge-penalty" style="margin-top:4px;">Ganador por penales</span>
                                }
                            }
                        </div>

                        <button type="button"
                                class="btn btn-warning btn-sm"
                                disabled="@(!PuedeSimularPartido(PartidoFinal))"
                                style="margin-left:8px; flex-shrink:0;"
                                @onclick="() => SimularPartido(PartidoFinal)">
                            Simular partido
                        </button>
                        <a href="/partidos/@PartidoFinal.Id/editar"
                           class="btn btn-success btn-sm"
                           style="margin-left:8px; flex-shrink:0;">
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                        </a>
                    </div>
                </div>
            }

            <!-- ── SEPARADOR ──────────────────────────────────── -->
            @if (PartidoFinal != null && PartidoTercerPuesto != null)
            {
                <div style="display:flex; align-items:center; gap:16px; margin:32px 0 24px;">
                    <div style="flex:1; height:1px; background:var(--border-default);"></div>
                    <span style="font-family:var(--font-heading); font-size:11px; font-weight:700;
                                 color:var(--text-muted); text-transform:uppercase; letter-spacing:0.1em;
                                 white-space:nowrap;">
                        Tercer Puesto
                    </span>
                    <div style="flex:1; height:1px; background:var(--border-default);"></div>
                </div>
            }

            <!-- ── TERCER PUESTO ──────────────────────────────── -->
            @if (PartidoTercerPuesto != null)
            {
                <div class="table-card">
                    <div class="table-card-header">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="font-size:18px; line-height:1">🥉</span>
                            <span class="table-card-title">Tercer Puesto</span>
                        </div>
                        <span class="badge badge-muted">3° lugar</span>
                    </div>

                    <div class="match-card">
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1;">
                            <div class="match-team"
                                 style="color:@(PartidoTercerPuesto.EstaJugado() && PartidoTercerPuesto.Ganador()?.Id == PartidoTercerPuesto.EquipoLocal?.Id
                                                ? "var(--text-primary)" : "var(--text-secondary)");">
                                @(PartidoTercerPuesto.EquipoLocal?.Nombre ?? "Por definir")
                            </div>
                            @if (PartidoTercerPuesto.FueDefinidoPorPenales() && PartidoTercerPuesto.GanadorPorPenales?.Id == PartidoTercerPuesto.EquipoLocal?.Id)
                            {
                                <span class="badge badge-penalty" style="align-self:flex-start; margin-top:2px;">Ganador por penales</span>
                            }
                        </div>
                        <div class="match-score" style="flex-direction:column; gap:2px;">
                            @if (PartidoTercerPuesto.EstaJugado())
                            {
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <span class="score-box">@PartidoTercerPuesto.GolesLocal</span>
                                    <span class="score-sep">—</span>
                                    <span class="score-box">@PartidoTercerPuesto.GolesVisitante</span>
                                </div>
                                @if (PartidoTercerPuesto.FueDefinidoPorPenales())
                                {
                                    <span style="font-size:10px; color:rgb(251,146,60); font-weight:600; text-transform:uppercase; letter-spacing:0.06em; text-align:center;">pen.</span>
                                }
                            }
                            else
                            {
                                <span style="font-size:12px; color:var(--text-muted)">vs</span>
                            }
                        </div>
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1; align-items:flex-end;">
                            <div class="match-team right"
                                 style="color:@(PartidoTercerPuesto.EstaJugado() && PartidoTercerPuesto.Ganador()?.Id == PartidoTercerPuesto.EquipoVisitante?.Id
                                                ? "var(--text-primary)" : "var(--text-secondary)");">
                                @(PartidoTercerPuesto.EquipoVisitante?.Nombre ?? "Por definir")
                            </div>
                            @if (PartidoTercerPuesto.FueDefinidoPorPenales() && PartidoTercerPuesto.GanadorPorPenales?.Id == PartidoTercerPuesto.EquipoVisitante?.Id)
                            {
                                <span class="badge badge-penalty" style="margin-top:2px;">Ganador por penales</span>
                            }
                        </div>
                        <div class="match-meta" style="margin-left:12px; min-width:110px; text-align:right;">
                            @PartidoTercerPuesto.Fecha.ToString("dd/MM/yy HH:mm")
                        </div>
                        <button type="button"
                                class="btn btn-warning btn-sm"
                                disabled="@(!PuedeSimularPartido(PartidoTercerPuesto))"
                                style="margin-left:8px; flex-shrink:0;"
                                @onclick="() => SimularPartido(PartidoTercerPuesto)">
                            Simular partido
                        </button>
                        <a href="/partidos/@PartidoTercerPuesto.Id/editar"
                           class="btn btn-success btn-sm"
                           style="margin-left:8px; flex-shrink:0;">
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                        </a>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <!-- Partidos de fases eliminatorias genéricas -->
        @if (!PartidosEtapaActiva.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">🏆</div>
                <div class="empty-state-title">Sin partidos disponibles</div>
                <div class="empty-state-text">No hay partidos disponibles para esta etapa.</div>
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="table-card-header">
                    <span class="table-card-title">@EtapaActivaEtiqueta</span>
                    <span class="badge badge-green">@PartidosEtapaActiva.Count partidos</span>
                </div>
                @foreach (var partido in PartidosEtapaActiva)
                {
                    <div class="match-card">
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1;">
                            <div class="match-team @(partido.EstaJugado() && partido.Ganador() == partido.EquipoLocal ? "match-winner" : "")">
                                @(partido.EquipoLocal?.Nombre ?? "Por definir")
                            </div>
                            @if (partido.FueDefinidoPorPenales() && partido.GanadorPorPenales?.Id == partido.EquipoLocal?.Id)
                            {
                                <span class="badge badge-penalty" style="align-self:flex-start; margin-top:2px;">Ganador por penales</span>
                            }
                        </div>
                        <div class="match-score" style="flex-direction:column; gap:2px;">
                            @if (partido.EstaJugado())
                            {
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <span class="score-box">@partido.GolesLocal</span>
                                    <span class="score-sep">—</span>
                                    <span class="score-box">@partido.GolesVisitante</span>
                                </div>
                                @if (partido.FueDefinidoPorPenales())
                                {
                                    <span style="font-size:10px; color:rgb(251,146,60); font-weight:600; text-transform:uppercase; letter-spacing:0.06em; text-align:center;">pen.</span>
                                }
                            }
                            else
                            {
                                <span style="font-size:12px; color:var(--text-muted)">vs</span>
                            }
                        </div>
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1; align-items:flex-end;">
                            <div class="match-team right @(partido.EstaJugado() && partido.Ganador() == partido.EquipoVisitante ? "match-winner" : "")">
                                @(partido.EquipoVisitante?.Nombre ?? "Por definir")
                            </div>
                            @if (partido.FueDefinidoPorPenales() && partido.GanadorPorPenales?.Id == partido.EquipoVisitante?.Id)
                            {
                                <span class="badge badge-penalty" style="margin-top:2px;">Ganador por penales</span>
                            }
                        </div>
                        <div class="match-meta" style="margin-left:12px; min-width:110px; text-align:right">
                            @partido.Fecha.ToString("dd/MM/yy HH:mm")
                        </div>
                        <button type="button"
                                class="btn btn-warning btn-sm"
                                disabled="@(!PuedeSimularPartido(partido))"
                                style="margin-left:8px; flex-shrink:0"
                                @onclick="() => SimularPartido(partido)">
                            Simular partido
                        </button>
                        <a href="/partidos/@partido.Id/editar" class="btn btn-success btn-sm" style="margin-left:8px; flex-shrink:0">
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                        </a>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private const int JornadaUno = 1;
    private const int JornadaDos = 2;
    private const int JornadaTres = 3;
    private const int CantidadPartidosPorJornadaGrupo = 2;

    private string _error = string.Empty;
    private string _grupoActivo = "A";
    private FaseTorneo _etapaActiva = FaseTorneo.FaseDeGrupos;
    private int _jornadaActiva = JornadaUno;
    private bool _generando = false;

    protected override void OnInitialized()
    {
        SincronizarJornadaActivaConPendiente();
    }

    private record EtapaTorneo(FaseTorneo Fase, string Etiqueta);

    private static readonly List<EtapaTorneo> EtapasDisponibles = new()
    {
        new(FaseTorneo.FaseDeGrupos,              "Fase de grupos"),
        new(FaseTorneo.PrimeraRondaEliminatoria,  "16avos"),
        new(FaseTorneo.Octavos,                   "8avos"),
        new(FaseTorneo.Cuartos,                   "4tos"),
        new(FaseTorneo.Semifinal,                 "Semifinal"),
        new(FaseTorneo.Final,                     "Final"),
    };

    private Grupo? GrupoSeleccionado =>
        EstadoTorneo.Fixture?.Grupos.FirstOrDefault(g => g.Etiqueta == _grupoActivo);

    private IEnumerable<PosicionEquipo> TablaGrupoSeleccionado =>
        GrupoSeleccionado == null
            ? Enumerable.Empty<PosicionEquipo>()
            : ServicioClasificacion.CalcularTabla(
                GrupoSeleccionado,
                ServicioConfiguracionTorneo.ObtenerConfiguracionActual());

    private string EtapaActivaEtiqueta =>
        EtapasDisponibles.FirstOrDefault(e => e.Fase == _etapaActiva)?.Etiqueta ?? string.Empty;

    private List<Partido> PartidosEtapaActiva =>
        EstadoTorneo.PartidosEliminatorios.Where(p => p.Fase == _etapaActiva).ToList();

    private Partido? PartidoFinal =>
        EstadoTorneo.PartidosEliminatorios.FirstOrDefault(p => p.Fase == FaseTorneo.Final);

    private Partido? PartidoTercerPuesto =>
        EstadoTorneo.PartidosEliminatorios.FirstOrDefault(p => p.Fase == FaseTorneo.TercerPuesto);

    private ConfiguracionTorneo ConfiguracionUsadaParaFixture =>
        ServicioConfiguracionTorneo.ObtenerConfiguracionUsadaParaFixture();

    private bool TorneoEstaFinalizado =>
        PartidoFinal != null && PartidoFinal.EstaJugado() && PartidoFinal.Ganador() != null;

    private void CrearNuevoTorneo()
    {
        EstadoTorneo.FixtureAnterior = EstadoTorneo.Fixture;
        EstadoTorneo.PartidosEliminatoriosAnteriores = EstadoTorneo.PartidosEliminatorios;
        EstadoTorneo.TorneoFinalizado = true;
        ServicioPersistenciaFixture.ArchivarTorneoActual();
        EstadoTorneo.Fixture = null;
        EstadoTorneo.PartidosEliminatorios = new();
        NavigationManager.NavigateTo("/fixture");
    }

    private void SeleccionarEtapa(FaseTorneo fase)
    {
        _etapaActiva = fase;
        SincronizarJornadaActivaConPendiente();
    }

    private void ManejarNavegacionTeclado(KeyboardEventArgs e, FaseTorneo fase)
    {
        var indice = EtapasDisponibles.FindIndex(et => et.Fase == fase);
        _etapaActiva = e.Key switch
        {
            "ArrowRight" when indice < EtapasDisponibles.Count - 1 => EtapasDisponibles[indice + 1].Fase,
            "ArrowLeft"  when indice > 0                           => EtapasDisponibles[indice - 1].Fase,
            "Home"                                                 => EtapasDisponibles[0].Fase,
            "End"                                                  => EtapasDisponibles[^1].Fase,
            _                                                      => _etapaActiva,
        };

        SincronizarJornadaActivaConPendiente();
    }

    private string ObtenerEstiloFilaPosicion(int posicion)
    {
        return posicion switch
        {
            1 => "background:rgba(34,197,94,0.14); border-left:3px solid rgba(34,197,94,0.8);",
            2 => "background:rgba(34,197,94,0.08); border-left:3px solid rgba(34,197,94,0.55);",
            3 => "background:rgba(148,163,184,0.06);",
            _ => string.Empty
        };
    }

    private void GenerarFixture()
    {
        _error = string.Empty;
        try
        {
            var equipos = ServicioEquipo.Buscar(_ => true);
            var estadios = ServicioEstadio.ObtenerEstadios();
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();

            var esFixtureNuevo = EstadoTorneo.Fixture == null;
            WorldCupPlanner.Dominio.Entidades.Fixture fixtureGenerado;

            if (esFixtureNuevo)
            {
                fixtureGenerado = ServicioFixture.GenerarFixture(equipos, estadios, config);
            }
            else
            {
                fixtureGenerado = ServicioFixture.RegenerarFixture(
                    equipos,
                    EstadoTorneo.Fixture!,
                    estadios,
                    config,
                    EstadoTorneo.PartidosEliminatorios);
            }

            EstadoTorneo.Fixture = fixtureGenerado;
            EstadoTorneo.PartidosEliminatorios = new();
            ServicioEquipo.RegistrarFixtureGenerado(EstadoTorneo.Fixture);
            ServicioEstadio.RegistrarFixtureGenerado(EstadoTorneo.Fixture);
            ServicioConfiguracionTorneo.RegistrarFixtureGenerado(config);
            ServicioPersistenciaFixture.GuardarFixture(EstadoTorneo.Fixture);
            SincronizarJornadaActivaConPendiente();
            Toast.Exito("Fixture generado correctamente.");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void SimularPartido(Partido? partido)
    {
        if (partido == null || !PuedeSimularPartido(partido))
        {
            _error = "Solo se puede simular el próximo partido pendiente del calendario.";
            return;
        }

        SimularPartidos(new List<Partido> { partido }, "Partido simulado correctamente.");
    }

    private void SimularJornadaOFecha()
    {
        var partidos = ObtenerPartidosJornadaOFechaActual();
        var mensaje = _etapaActiva == FaseTorneo.FaseDeGrupos
            ? "Jornada simulada correctamente."
            : "Fecha simulada correctamente.";

        SimularPartidos(partidos, mensaje);
    }

    private void SimularFaseActiva()
    {
        SimularPartidos(
            ObtenerPartidosPendientesEtapaActiva(),
            "Fase simulada correctamente.");
    }

    private void SimularPartidos(List<Partido> partidos, string mensajeExito)
    {
        _error = string.Empty;

        if (!partidos.Any())
        {
            _error = "No hay partidos pendientes para simular en la fase actual.";
            return;
        }

        try
        {
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            ServicioSimulacion.SimularResultados(partidos, config);
            ServicioPersistenciaFixture.GuardarPartidos(partidos);
            SincronizarJornadaActivaConPendiente();
            Toast.Exito(mensajeExito);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private bool EsEtapaActivaSimulable =>
        ObtenerFaseActualSimulable() == _etapaActiva;

    private bool PuedeSimularPartido(Partido? partido)
    {
        return partido != null
            && EsEtapaActivaSimulable
            && PerteneceAEtapaActiva(partido)
            && !partido.EstaJugado()
            && ReferenceEquals(partido, ObtenerProximoPartidoSimulable());
    }

    private bool PuedeSimularJornadaOFecha()
    {
        return ObtenerPartidosJornadaOFechaActual().Any();
    }

    private bool PuedeSimularFaseActiva()
    {
        return ObtenerPartidosPendientesEtapaActiva().Any();
    }

    private FaseTorneo? ObtenerFaseActualSimulable()
    {
        if (EstadoTorneo.Fixture == null)
        {
            return null;
        }

        if (EstadoTorneo.Fixture.Partidos.Any(p => !p.EstaJugado()))
        {
            return FaseTorneo.FaseDeGrupos;
        }

        var fasesEliminatorias = new[]
        {
            FaseTorneo.PrimeraRondaEliminatoria,
            FaseTorneo.Octavos,
            FaseTorneo.Cuartos,
            FaseTorneo.Semifinal
        };

        foreach (var fase in fasesEliminatorias)
        {
            if (EstadoTorneo.PartidosEliminatorios.Any(p => p.Fase == fase && !p.EstaJugado()))
            {
                return fase;
            }
        }

        if (EstadoTorneo.PartidosEliminatorios.Any(p =>
                (p.Fase == FaseTorneo.Final || p.Fase == FaseTorneo.TercerPuesto)
                && !p.EstaJugado()))
        {
            return FaseTorneo.Final;
        }

        return null;
    }

    private bool PerteneceAEtapaActiva(Partido partido)
    {
        if (_etapaActiva == FaseTorneo.Final)
        {
            return partido.Fase == FaseTorneo.Final || partido.Fase == FaseTorneo.TercerPuesto;
        }

        return partido.Fase == _etapaActiva;
    }

    private List<Partido> ObtenerPartidosPendientesEtapaActiva()
    {
        if (!EsEtapaActivaSimulable)
        {
            return new List<Partido>();
        }

        return ObtenerPartidosEtapaActiva()
            .Where(p => !p.EstaJugado())
            .ToList();
    }

    private List<Partido> ObtenerPartidosJornadaOFechaActual()
    {
        if (!EsEtapaActivaSimulable)
        {
            return new List<Partido>();
        }

        if (_etapaActiva != FaseTorneo.FaseDeGrupos)
        {
            return ObtenerPartidosPendientesDePrimeraFechaActual();
        }

        var jornadaPendiente = ObtenerJornadaPendienteActual();

        if (!jornadaPendiente.HasValue || _jornadaActiva != jornadaPendiente.Value)
        {
            return new List<Partido>();
        }

        return ObtenerPartidosPendientesDeJornada(_jornadaActiva);
    }

    private List<Partido> ObtenerPartidosEtapaActiva()
    {
        if (EstadoTorneo.Fixture == null)
        {
            return new List<Partido>();
        }

        if (_etapaActiva == FaseTorneo.FaseDeGrupos)
        {
            return EstadoTorneo.Fixture.Partidos;
        }

        if (_etapaActiva == FaseTorneo.Final)
        {
            return EstadoTorneo.PartidosEliminatorios
                .Where(p => p.Fase == FaseTorneo.Final || p.Fase == FaseTorneo.TercerPuesto)
                .ToList();
        }

        return EstadoTorneo.PartidosEliminatorios
            .Where(p => p.Fase == _etapaActiva)
            .ToList();
    }

    private List<Partido> ObtenerPartidosPendientesDeJornada(int jornada)
    {
        if (EstadoTorneo.Fixture == null)
        {
            return new List<Partido>();
        }

        var indiceInicial = (jornada - JornadaUno) * CantidadPartidosPorJornadaGrupo;

        return EstadoTorneo.Fixture.Grupos
            .SelectMany(g => g.Partidos
                .Skip(indiceInicial)
                .Take(CantidadPartidosPorJornadaGrupo))
            .Where(p => !p.EstaJugado())
            .ToList();
    }

    private List<Partido> ObtenerPartidosPendientesDePrimeraFechaActual()
    {
        var pendientes = ObtenerPartidosPendientesEtapaActiva();

        if (!pendientes.Any())
        {
            return new List<Partido>();
        }

        var fecha = pendientes.Min(p => p.Fecha.Date);

        return pendientes
            .Where(p => p.Fecha.Date == fecha)
            .ToList();
    }

    private List<Partido> ObtenerPartidosSimulablesAhora()
    {
        if (!EsEtapaActivaSimulable)
        {
            return new List<Partido>();
        }

        if (_etapaActiva != FaseTorneo.FaseDeGrupos)
        {
            return ObtenerPartidosPendientesDePrimeraFechaActual();
        }

        var jornadaPendiente = ObtenerJornadaPendienteActual();

        return jornadaPendiente.HasValue
            ? ObtenerPartidosPendientesDeJornada(jornadaPendiente.Value)
            : new List<Partido>();
    }

    private Partido? ObtenerProximoPartidoSimulable()
    {
        return ObtenerPartidosSimulablesAhora()
            .OrderBy(p => p.Fecha)
            .ThenBy(p => p.Id)
            .FirstOrDefault();
    }

    private int? ObtenerJornadaPendienteActual()
    {
        for (var jornada = JornadaUno; jornada <= JornadaTres; jornada++)
        {
            if (ObtenerPartidosPendientesDeJornada(jornada).Any())
            {
                return jornada;
            }
        }

        return null;
    }

    private bool EsJornadaSeleccionable(int jornada)
    {
        var jornadaPendiente = ObtenerJornadaPendienteActual();
        return jornadaPendiente.HasValue && jornada == jornadaPendiente.Value;
    }

    private void SincronizarJornadaActivaConPendiente()
    {
        if (_etapaActiva != FaseTorneo.FaseDeGrupos)
        {
            return;
        }

        var jornadaPendiente = ObtenerJornadaPendienteActual();

        if (jornadaPendiente.HasValue)
        {
            _jornadaActiva = jornadaPendiente.Value;
        }
    }

    private bool FaseYaGenerada(FaseTorneo fase)
    {
        if (fase == FaseTorneo.Final)
            return EstadoTorneo.PartidosEliminatorios.Any(p => p.Fase == FaseTorneo.Final || p.Fase == FaseTorneo.TercerPuesto);
        return EstadoTorneo.PartidosEliminatorios.Any(p => p.Fase == fase);
    }

    private bool GruposCompletos() =>
        EstadoTorneo.Fixture?.Partidos.All(p => p.EstaJugado()) ?? false;

    private bool FaseEliminatoriaCompleta(FaseTorneo fase)
    {
        var partidos = EstadoTorneo.PartidosEliminatorios.Where(p => p.Fase == fase).ToList();
        return partidos.Any() && partidos.All(p => p.EstaJugado() && p.Ganador() != null);
    }

    private bool PuedeGenerarFase(FaseTorneo fase) => fase switch
    {
        FaseTorneo.PrimeraRondaEliminatoria => GruposCompletos(),
        FaseTorneo.Octavos   => FaseEliminatoriaCompleta(FaseTorneo.PrimeraRondaEliminatoria),
        FaseTorneo.Cuartos   => FaseEliminatoriaCompleta(FaseTorneo.Octavos),
        FaseTorneo.Semifinal => FaseEliminatoriaCompleta(FaseTorneo.Cuartos),
        FaseTorneo.Final     => FaseEliminatoriaCompleta(FaseTorneo.Semifinal),
        _                    => false
    };

    private string MensajeCondicionFaseActiva
    {
        get
        {
            if (_etapaActiva == FaseTorneo.FaseDeGrupos || FaseYaGenerada(_etapaActiva) || PuedeGenerarFase(_etapaActiva))
                return string.Empty;

            return _etapaActiva switch
            {
                FaseTorneo.PrimeraRondaEliminatoria =>
                    "Para generar los 16avos, todos los partidos de la fase de grupos deben estar jugados.",
                FaseTorneo.Octavos => !FaseYaGenerada(FaseTorneo.PrimeraRondaEliminatoria)
                    ? "Primero debés generar la primera ronda eliminatoria (16avos)."
                    : "Para generar los 8avos, todos los partidos de 16avos deben estar jugados y con ganador definido.",
                FaseTorneo.Cuartos => !FaseYaGenerada(FaseTorneo.Octavos)
                    ? "Primero debés generar los 8avos de final."
                    : "Para generar los 4tos, todos los partidos de 8avos deben estar jugados y con ganador definido.",
                FaseTorneo.Semifinal => !FaseYaGenerada(FaseTorneo.Cuartos)
                    ? "Primero debés generar los cuartos de final."
                    : "Para generar las semifinales, todos los partidos de 4tos deben estar jugados y con ganador definido.",
                FaseTorneo.Final => !FaseYaGenerada(FaseTorneo.Semifinal)
                    ? "Primero debés generar las semifinales."
                    : "Para generar la final, todos los partidos de semifinales deben estar jugados y con ganador definido.",
                _ => string.Empty
            };
        }
    }

    private List<Partido> PartidosDeFase(FaseTorneo fase) =>
        EstadoTorneo.PartidosEliminatorios.Where(p => p.Fase == fase).ToList();

    private async Task GenerarFaseActiva()
    {
        switch (_etapaActiva)
        {
            case FaseTorneo.PrimeraRondaEliminatoria: GenerarPrimeraRondaEliminatoria(); break;
            case FaseTorneo.Octavos:                  GenerarOctavos();                  break;
            case FaseTorneo.Cuartos:                  GenerarCuartos();                  break;
            case FaseTorneo.Semifinal:                GenerarSemifinales();              break;
            case FaseTorneo.Final:                    await GenerarFinalYTercerPuesto(); break;
        }
    }

    private void GenerarPrimeraRondaEliminatoria()
    {
        _error = string.Empty;
        try
        {
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            var clasificados = ServicioClasificacion.ObtenerClasificadosAFaseEliminatoria(EstadoTorneo.Fixture!, config);
            var estadios = ServicioEstadio.ObtenerEstadios();
            EstadoTorneo.PartidosEliminatorios = ServicioCruces.GenerarPrimeraRondaEliminatoria(
                new ContextoSorteo
                {
                    Clasificados = clasificados,
                    Estadios = estadios,
                    ConfiguracionTorneo = config,
                    FechaUltimoPartidoFaseGrupos = EstadoTorneo.Fixture!.Partidos.Max(p => p.Fecha)
                });
            ServicioPersistenciaFixture.GuardarPartidos(EstadoTorneo.PartidosEliminatorios);
            Toast.Exito("16avos de final generados correctamente.");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void GenerarOctavos()
    {
        _error = string.Empty;
        try
        {
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            var estadios = ServicioEstadio.ObtenerEstadios();
            var octavos = ServicioCruces.GenerarOctavos(PartidosDeFase(FaseTorneo.PrimeraRondaEliminatoria), estadios, config);
            EstadoTorneo.PartidosEliminatorios.AddRange(octavos);
            ServicioPersistenciaFixture.GuardarPartidos(octavos);
            Toast.Exito("8avos de final generados correctamente.");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void GenerarCuartos()
    {
        _error = string.Empty;
        try
        {
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            var estadios = ServicioEstadio.ObtenerEstadios();
            var cuartos = ServicioCruces.GenerarCuartos(PartidosDeFase(FaseTorneo.Octavos), estadios, config);
            EstadoTorneo.PartidosEliminatorios.AddRange(cuartos);
            ServicioPersistenciaFixture.GuardarPartidos(cuartos);
            Toast.Exito("Cuartos de final generados correctamente.");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void GenerarSemifinales()
    {
        _error = string.Empty;
        try
        {
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            var estadios = ServicioEstadio.ObtenerEstadios();
            var semifinales = ServicioCruces.GenerarSemifinales(PartidosDeFase(FaseTorneo.Cuartos), estadios, config);
            EstadoTorneo.PartidosEliminatorios.AddRange(semifinales);
            ServicioPersistenciaFixture.GuardarPartidos(semifinales);
            Toast.Exito("Semifinales generadas correctamente.");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task GenerarFinalYTercerPuesto()
    {
        _error = string.Empty;
        _generando = true;
        StateHasChanged();
        try
        {
            await Task.Yield();
            var config = ServicioConfiguracionTorneo.ObtenerConfiguracionActual();
            var estadios = ServicioEstadio.ObtenerEstadios();
            var semifinales = PartidosDeFase(FaseTorneo.Semifinal);
            var existentes = EstadoTorneo.PartidosEliminatorios;
            var tercerPuesto = ServicioCruces.GenerarTercerPuesto(semifinales, estadios, config, existentes);
            var final = ServicioCruces.GenerarFinal(semifinales, estadios, config, existentes);
            EstadoTorneo.PartidosEliminatorios.Add(tercerPuesto);
            EstadoTorneo.PartidosEliminatorios.Add(final);
            ServicioPersistenciaFixture.GuardarPartidos(new[] { tercerPuesto, final });
            Toast.Exito("Final y tercer puesto generados correctamente.");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _generando = false;
        }
    }
}
