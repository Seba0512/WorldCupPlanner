@page "/fixture"
@using WorldCupPlanner.Controladores
@using WorldCupPlanner.Dominio.DTO
@inject ControladorFixture ControladorFixture
@inject ControladorClasificacion ControladorClasificacion
@inject EstadoTorneo EstadoTorneo
@inject ControladorSimulacion ControladorSimulacion
@inject ControladorConfiguracionTorneo ControladorConfiguracionTorneo
@inject ControladorFaseEliminatoria ControladorFaseEliminatoria
@inject SesionServicio SesionServicio
@inject ToastServicio Toast
@inject NavigationManager NavigationManager

<PageTitle>Fixture — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Fixture" Subtitulo="Fase de grupos y cruces eliminatorios">
    <AccionesContent>
        @if (SesionServicio.PuedeEditarPartidos && EstadoTorneo.Fixture != null)
        {
            @if (_etapaActiva != FaseTorneo.FaseDeGrupos)
            {
                <button class="btn btn-primary btn-sm"
                        disabled="@(ControladorFixture.FaseYaGenerada(_etapaActiva, EstadoTorneo) || !ControladorFixture.PuedeGenerarFase(_etapaActiva, EstadoTorneo) || _generando)"
                        @onclick="GenerarFaseActiva">
                    @if (_generando)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Generando...</span>
                    }
                    else
                    {
                        <span class="oi oi-cog" aria-hidden="true"></span>
                        <span>@(ControladorFixture.FaseYaGenerada(_etapaActiva, EstadoTorneo) ? "Cruces generados" : "Generar Cruces")</span>
                    }
                </button>
            }
            <div class="btn-group btn-group-sm" role="group" aria-label="Opciones de simulación">
                @if (_etapaActiva == FaseTorneo.FaseDeGrupos)
                {
                    <select class="form-select form-select-sm"
                            style="width:auto"
                            @bind="_jornadaActiva"
                            disabled="@(!EsEtapaActivaSimulable)">
                        <option value="@ServicioFixture.PrimeraJornada" disabled="@(!ControladorFixture.EsJornadaSeleccionable(ServicioFixture.PrimeraJornada, EstadoTorneo.Fixture))">Jornada 1</option>
                        <option value="@ServicioFixture.SegundaJornada" disabled="@(!ControladorFixture.EsJornadaSeleccionable(ServicioFixture.SegundaJornada, EstadoTorneo.Fixture))">Jornada 2</option>
                        <option value="@ServicioFixture.TerceraJornada" disabled="@(!ControladorFixture.EsJornadaSeleccionable(ServicioFixture.TerceraJornada, EstadoTorneo.Fixture))">Jornada 3</option>
                    </select>
                }
                <button class="btn btn-warning"
                        disabled="@(!PuedeSimularJornadaOFecha())"
                        @onclick="SimularJornadaOFecha">
                    <span class="oi oi-clock" aria-hidden="true"></span>
                    Simular @(_etapaActiva == FaseTorneo.FaseDeGrupos ? "jornada" : "fecha")
                </button>
                <button class="btn btn-warning"
                        disabled="@(!PuedeSimularFaseActiva())"
                        @onclick="SimularFaseActiva">
                    <span class="oi oi-cog" aria-hidden="true"></span> Simular fase
                </button>
            </div>
        }
    </AccionesContent>
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        <span class="oi oi-warning" aria-hidden="true"></span> @_error
    </div>
}

@if (!string.IsNullOrEmpty(MensajeCondicionFaseActiva))
{
    <div class="alert alert-info">
        <span class="oi oi-info" aria-hidden="true"></span> @MensajeCondicionFaseActiva
    </div>
}

@if (EstadoTorneo.Fixture == null)
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="glass-card" style="padding:32px; text-align:center;">
                <div style="font-size:48px; margin-bottom:16px">⚽</div>
                <h3 style="font-family:var(--font-heading); font-size:20px; font-weight:700; margin-bottom:8px">
                    Fase de Grupos
                </h3>
                <p style="font-size:14px; color:var(--text-secondary); margin-bottom:20px; line-height:1.6">
                    Generá el fixture completo de la fase de grupos. Necesitás exactamente 48 equipos registrados y al menos 4 estadios. Si faltan equipos, completalos primero desde la sección <strong>Equipos</strong>.
                </p>
                <div class="form-group" style="text-align:left; margin-bottom:16px">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                        <label class="form-label" style="margin:0">Configuración activa</label>
                        @if (SesionServicio.EsAdministrador)
                        {
                            <a href="/configuracion" class="btn btn-link btn-sm" style="font-size:12px; padding:0;">
                                <span class="oi oi-cog" aria-hidden="true"></span> Editar
                            </a>
                        }
                    </div>
                    @{
                        var configActual = ControladorConfiguracionTorneo.ObtenerConfiguracionActualDTO();
                    }
                    <div style="font-size:13px; color:var(--text-secondary);">
                        Semilla: <strong>@configActual.SemillaFixture</strong> —
                        Inicio: <strong>@configActual.FechaInicioTorneo.ToString("yyyy-MM-dd")</strong> —
                        Máx. @configActual.MaxPartidosPorDia partidos/día
                    </div>
                    <div style="margin-top:12px;">
                        <label class="form-label">Motor de simulacion</label>
                        <select class="form-select"
                                @bind="_motorSimulacionSeleccionado"
                                disabled="@(!SesionServicio.PuedeEditarPartidos)">
                            @foreach (var motor in ControladorSimulacion.ObtenerMotoresDisponibles())
                            {
                                <option value="@motor.Tipo">@motor.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                @if (SesionServicio.PuedeEditarPartidos)
                {
                    <button type="button" class="btn btn-primary w-100" @onclick="GenerarFixture">
                        <span class="oi oi-cog" aria-hidden="true"></span> Generar Fixture
                    </button>
                }
                @if (EstadoTorneo.FixtureAnterior != null)
                {
                    <a href="/fixture/anterior" class="btn btn-secondary w-100 mt-2">
                        <span class="oi oi-eye" aria-hidden="true"></span> Ver torneo anterior
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="table-card" style="height:100%">
                <div class="table-card-header"><span class="table-card-title">¿Cómo funciona?</span></div>
                <div style="padding:20px;">
                    <div style="display:flex; gap:12px; margin-bottom:14px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">1</span>
                        <span style="font-size:13px; color:var(--text-secondary)">48 equipos se dividen en 12 grupos (A–L) de 4 equipos cada uno.</span>
                    </div>
                    <div style="display:flex; gap:12px; margin-bottom:14px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">2</span>
                        <span style="font-size:13px; color:var(--text-secondary)">Cada equipo juega contra los otros 3 de su grupo (round-robin).</span>
                    </div>
                    <div style="display:flex; gap:12px; align-items:flex-start">
                        <span class="badge badge-blue" style="width:24px; justify-content:center; flex-shrink:0">3</span>
                        <span style="font-size:13px; color:var(--text-secondary)">Los primeros y segundos de cada grupo, más los mejores terceros, avanzan.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <span class="badge badge-green" style="font-size:12px; padding:5px 12px">
                <span class="oi oi-check" aria-hidden="true"></span> Fixture generado — @FixtureActualDTO?.Partidos.Count partidos
            </span>
        </div>
    </div>

    @if (EstadoTorneo.TorneoFinalizado)
    {
        <div class="alert alert-success mb-3">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div>
                    <strong>¡Torneo finalizado!</strong>
                    — Campeón: <strong>@Campeon?.Nombre</strong>
                </div>
                @if (SesionServicio.PuedeEditarPartidos)
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CrearNuevoTorneo">
                        <span class="oi oi-plus" aria-hidden="true"></span> Crear nuevo torneo
                    </button>
                }
            </div>
        </div>
    }

    <div class="stage-tabs" role="tablist" aria-label="Etapas del torneo">
        @foreach (var etapa in EtapasDisponibles)
        {
            <button class="stage-tab @(_etapaActiva == etapa.Fase ? "active" : "")"
                    role="tab"
                    aria-selected="@(_etapaActiva == etapa.Fase ? "true" : "false")"
                    tabindex="@(_etapaActiva == etapa.Fase ? 0 : -1)"
                    @onclick="() => SeleccionarEtapa(etapa.Fase)"
                    @onkeydown="(e) => ManejarNavegacionTeclado(e, etapa.Fase)">
                @etapa.Etiqueta
            </button>
        }
    </div>


    
    @if (_etapaActiva == FaseTorneo.FaseDeGrupos)
    {
        <!-- Tabs de grupos -->
        <div class="group-tabs" role="tablist" aria-label="Grupos de la fase de grupos">
            @foreach (var grupo in GruposFixtureActual)
            {
                <button class="group-tab @(_grupoActivo == grupo.Etiqueta ? "active" : "")"
                        role="tab"
                        aria-selected="@(_grupoActivo == grupo.Etiqueta ? "true" : "false")"
                        tabindex="@(_grupoActivo == grupo.Etiqueta ? 0 : -1)"
                        @onclick="() => _grupoActivo = grupo.Etiqueta">
                    Grupo @grupo.Etiqueta
                </button>
            }
        </div>

        <!-- Partidos del grupo activo -->
        @if (GrupoSeleccionadoDTO != null)
        {
            <div class="table-card mb-3">
                <div class="table-card-header">
                    <span class="table-card-title">Tabla de posiciones — Grupo @GrupoSeleccionadoDTO.Etiqueta</span>
                    <span style="font-size:12px; color:var(--text-secondary)">4 equipos</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-sm mb-0" style="font-size:13px; vertical-align:middle;">
                        <thead>
                            <tr style="color:var(--text-secondary); text-transform:uppercase; font-size:11px; letter-spacing:0.04em;">
                                <th style="width:72px;">Posición</th>
                                <th>Equipo</th>
                                <th class="text-center">PJ</th>
                                <th class="text-center">PG</th>
                                <th class="text-center">PE</th>
                                <th class="text-center">PP</th>
                                <th class="text-center">GF</th>
                                <th class="text-center">GC</th>
                                <th class="text-center">DG</th>
                                <th class="text-center">Pts</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var posicion in TablaGrupoSeleccionado)
                            {
                                <tr style="@TablaGruposHelper.ObtenerEstiloFilaPosicion(posicion.Posicion)">
                                    <td>
                                        <span style="font-weight:700;">@posicion.Posicion</span>
                                        @if (posicion.Clasifica)
                                        {
                                            <span class="badge badge-green" style="margin-left:6px;">Clasifica</span>
                                        }
                                        else if (posicion.EsTercero)
                                        {
                                            <span class="badge badge-muted" style="margin-left:6px;">3°</span>
                                        }
                                    </td>
                                    <td style="font-weight:700;">@posicion.EquipoNombre</td>
                                    <td class="text-center">@posicion.PartidosJugados</td>
                                    <td class="text-center">@posicion.PartidosGanados</td>
                                    <td class="text-center">@posicion.PartidosEmpatados</td>
                                    <td class="text-center">@posicion.PartidosPerdidos</td>
                                    <td class="text-center">@posicion.GolesAFavor</td>
                                    <td class="text-center">@posicion.GolesEnContra</td>
                                    <td class="text-center">@posicion.DiferenciaGoles</td>
                                    <td class="text-center" style="font-weight:800;">@posicion.Puntos</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="table-card mb-4">
                <div class="table-card-header">
                    <span class="table-card-title">Grupo @GrupoSeleccionadoDTO.Etiqueta</span>
                    <span style="font-size:12px; color:var(--text-secondary)">@GrupoSeleccionadoDTO.Partidos.Count partidos</span>
                </div>
                @foreach (var partido in GrupoSeleccionadoDTO.Partidos)
                {
                    var partidoDominio = ObtenerPartidoDominio(partido);
                    <div class="match-card @(ControladorFixture.EstaJugado(partido) && (ControladorFixture.EsGanador(partido, partido.EquipoLocal) || ControladorFixture.EsGanador(partido, partido.EquipoVisitante)) ? "match-winner" : "")">
                        <div class="match-team @(ControladorFixture.EsGanador(partido, partido.EquipoLocal) ? "match-winner" : "")">
                            @partido.EquipoLocal?.Nombre
                        </div>
                        <div class="match-score">
                            @if (ControladorFixture.EstaJugado(partido))
                            {
                                <span class="score-box">@partido.GolesLocal</span>
                                <span class="score-sep">—</span>
                                <span class="score-box">@partido.GolesVisitante</span>
                            }
                            else
                            {
                                <span style="font-size:12px; color:var(--text-muted)">vs</span>
                            }
                        </div>
                        <div class="match-team right @(ControladorFixture.EsGanador(partido, partido.EquipoVisitante) ? "match-winner" : "")">
                            @partido.EquipoVisitante?.Nombre
                        </div>
                        <div class="match-meta" style="margin-left:12px; text-align:right; min-width:110px">
                            @partido.Fecha.ToString("dd/MM/yy HH:mm")
                        </div>
                        @if (SesionServicio.PuedeEditarPartidos)
                        {
                            <button type="button"
                                    class="btn btn-warning btn-sm"
                                    disabled="@(!PuedeSimularPartido(partidoDominio))"
                                    style="margin-left:8px; flex-shrink:0"
                                    @onclick="() => SimularPartido(partidoDominio)">
                                Simular partido
                            </button>
                            <a href="/partidos/@partido.Id/editar" class="btn btn-success btn-sm" style="margin-left:8px; flex-shrink:0">
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (_etapaActiva == FaseTorneo.Final)
    {
        <!-- Layout diferenciado: Final y Tercer Puesto -->
        @if (PartidoFinal == null && PartidoTercerPuesto == null)
        {
            <div class="empty-state">
                <div class="empty-state-icon">🏆</div>
                <div class="empty-state-title">Sin partidos disponibles</div>
                <div class="empty-state-text">Generá los cruces de la Final una vez que las Semifinales estén completas.</div>
            </div>
        }
        else
        {
            <!-- ── FINAL ───────────────────────────────────────── -->
            @if (PartidoFinal != null)
            {
                <div class="table-card mb-4"
                     style="border-color:rgba(244,185,66,0.35); box-shadow:var(--shadow-gold);">
                    <div class="table-card-header"
                         style="background:linear-gradient(135deg,rgba(244,185,66,0.12),rgba(244,185,66,0.04));
                                border-bottom-color:rgba(244,185,66,0.2);">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span style="font-size:22px; line-height:1">🏆</span>
                            <div>
                                <div class="table-card-title"
                                     style="color:var(--accent-gold); font-size:17px; letter-spacing:0.02em;">
                                    Gran Final
                                </div>
                                <div style="font-size:11px; color:var(--text-muted); font-weight:600;
                                            text-transform:uppercase; letter-spacing:0.08em; margin-top:2px;">
                                    World Cup 2026
                                </div>
                            </div>
                        </div>
                        <span class="badge badge-gold">Partido decisivo</span>
                    </div>

                    <div class="match-card" style="padding:28px 20px; gap:16px;">
                        <div style="flex:1; text-align:left;">
                            <div style="font-family:var(--font-heading); font-size:18px; font-weight:700;
                                        color:@(PartidoFinal.EstaJugado() && PartidoFinal.Ganador()?.Id == PartidoFinal.EquipoLocal?.Id
                                                 ? "var(--accent-gold)" : "var(--text-primary)");">
                                @(PartidoFinal.EquipoLocal?.Nombre ?? "Por definir")
                            </div>
                            @if (PartidoFinal.EstaJugado() && PartidoFinal.Ganador()?.Id == PartidoFinal.EquipoLocal?.Id)
                            {
                                <div style="font-size:10px; font-weight:700; text-transform:uppercase;
                                            letter-spacing:0.1em; color:var(--accent-gold); margin-top:4px;">
                                    🥇 Campeón
                                </div>
                                @if (PartidoFinal.FueDefinidoPorPenales())
                                {
                                    <span class="badge badge-penalty" style="margin-top:4px;">Ganador por penales</span>
                                }
                            }
                        </div>

                        <div class="match-score" style="min-width:100px; flex-direction:column; gap:4px;">
                            @if (PartidoFinal.EstaJugado())
                            {
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span class="score-box"
                                          style="font-size:32px; color:var(--accent-gold); min-width:36px;">
                                        @PartidoFinal.GolesLocal
                                    </span>
                                    <span class="score-sep" style="font-size:18px;">—</span>
                                    <span class="score-box"
                                          style="font-size:32px; color:var(--accent-gold); min-width:36px;">
                                        @PartidoFinal.GolesVisitante
                                    </span>
                                </div>
                                @if (PartidoFinal.FueDefinidoPorPenales())
                                {
                                    <span style="font-size:11px; color:rgb(251,146,60); font-weight:700;
                                                 text-transform:uppercase; letter-spacing:0.06em; text-align:center;">
                                        Penales
                                    </span>
                                }
                            }
                            else
                            {
                                <span style="font-size:13px; color:var(--text-muted); font-weight:600;
                                             letter-spacing:0.06em; text-transform:uppercase;">vs</span>
                            }
                            <div style="font-size:11px; color:var(--text-muted); white-space:nowrap;">
                                @PartidoFinal.Fecha.ToString("dd/MM/yy HH:mm")
                            </div>
                        </div>

                        <div style="flex:1; text-align:right;">
                            <div style="font-family:var(--font-heading); font-size:18px; font-weight:700;
                                        color:@(PartidoFinal.EstaJugado() && PartidoFinal.Ganador()?.Id == PartidoFinal.EquipoVisitante?.Id
                                                 ? "var(--accent-gold)" : "var(--text-primary)");">
                                @(PartidoFinal.EquipoVisitante?.Nombre ?? "Por definir")
                            </div>
                            @if (PartidoFinal.EstaJugado() && PartidoFinal.Ganador()?.Id == PartidoFinal.EquipoVisitante?.Id)
                            {
                                <div style="font-size:10px; font-weight:700; text-transform:uppercase;
                                            letter-spacing:0.1em; color:var(--accent-gold); margin-top:4px;">
                                    🥇 Campeón
                                </div>
                                @if (PartidoFinal.FueDefinidoPorPenales())
                                {
                                    <span class="badge badge-penalty" style="margin-top:4px;">Ganador por penales</span>
                                }
                            }
                        </div>

                        @if (SesionServicio.PuedeEditarPartidos)
                        {
                            <button type="button"
                                    class="btn btn-warning btn-sm"
                                    disabled="@(!PuedeSimularPartido(PartidoFinal))"
                                    style="margin-left:8px; flex-shrink:0;"
                                    @onclick="() => SimularPartido(PartidoFinal)">
                                Simular partido
                            </button>
                            <a href="/partidos/@PartidoFinal.Id/editar"
                               class="btn btn-success btn-sm"
                               style="margin-left:8px; flex-shrink:0;">
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- ── SEPARADOR ──────────────────────────────────── -->
            @if (PartidoFinal != null && PartidoTercerPuesto != null)
            {
                <div style="display:flex; align-items:center; gap:16px; margin:32px 0 24px;">
                    <div style="flex:1; height:1px; background:var(--border-default);"></div>
                    <span style="font-family:var(--font-heading); font-size:11px; font-weight:700;
                                 color:var(--text-muted); text-transform:uppercase; letter-spacing:0.1em;
                                 white-space:nowrap;">
                        Tercer Puesto
                    </span>
                    <div style="flex:1; height:1px; background:var(--border-default);"></div>
                </div>
            }

            <!-- ── TERCER PUESTO ──────────────────────────────── -->
            @if (PartidoTercerPuesto != null)
            {
                <div class="table-card">
                    <div class="table-card-header">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="font-size:18px; line-height:1">🥉</span>
                            <span class="table-card-title">Tercer Puesto</span>
                        </div>
                        <span class="badge badge-muted">3° lugar</span>
                    </div>

                    <div class="match-card">
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1;">
                            <div class="match-team"
                                 style="color:@(PartidoTercerPuesto.EstaJugado() && PartidoTercerPuesto.Ganador()?.Id == PartidoTercerPuesto.EquipoLocal?.Id
                                                ? "var(--text-primary)" : "var(--text-secondary)");">
                                @(PartidoTercerPuesto.EquipoLocal?.Nombre ?? "Por definir")
                            </div>
                            @if (PartidoTercerPuesto.FueDefinidoPorPenales() && PartidoTercerPuesto.GanadorPorPenales?.Id == PartidoTercerPuesto.EquipoLocal?.Id)
                            {
                                <span class="badge badge-penalty" style="align-self:flex-start; margin-top:2px;">Ganador por penales</span>
                            }
                        </div>
                        <div class="match-score" style="flex-direction:column; gap:2px;">
                            @if (PartidoTercerPuesto.EstaJugado())
                            {
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <span class="score-box">@PartidoTercerPuesto.GolesLocal</span>
                                    <span class="score-sep">—</span>
                                    <span class="score-box">@PartidoTercerPuesto.GolesVisitante</span>
                                </div>
                                @if (PartidoTercerPuesto.FueDefinidoPorPenales())
                                {
                                    <span style="font-size:10px; color:rgb(251,146,60); font-weight:600; text-transform:uppercase; letter-spacing:0.06em; text-align:center;">pen.</span>
                                }
                            }
                            else
                            {
                                <span style="font-size:12px; color:var(--text-muted)">vs</span>
                            }
                        </div>
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1; align-items:flex-end;">
                            <div class="match-team right"
                                 style="color:@(PartidoTercerPuesto.EstaJugado() && PartidoTercerPuesto.Ganador()?.Id == PartidoTercerPuesto.EquipoVisitante?.Id
                                                ? "var(--text-primary)" : "var(--text-secondary)");">
                                @(PartidoTercerPuesto.EquipoVisitante?.Nombre ?? "Por definir")
                            </div>
                            @if (PartidoTercerPuesto.FueDefinidoPorPenales() && PartidoTercerPuesto.GanadorPorPenales?.Id == PartidoTercerPuesto.EquipoVisitante?.Id)
                            {
                                <span class="badge badge-penalty" style="margin-top:2px;">Ganador por penales</span>
                            }
                        </div>
                        <div class="match-meta" style="margin-left:12px; min-width:110px; text-align:right;">
                            @PartidoTercerPuesto.Fecha.ToString("dd/MM/yy HH:mm")
                        </div>
                        @if (SesionServicio.PuedeEditarPartidos)
                        {
                            <button type="button"
                                    class="btn btn-warning btn-sm"
                                    disabled="@(!PuedeSimularPartido(PartidoTercerPuesto))"
                                    style="margin-left:8px; flex-shrink:0;"
                                    @onclick="() => SimularPartido(PartidoTercerPuesto)">
                                Simular partido
                            </button>
                            <a href="/partidos/@PartidoTercerPuesto.Id/editar"
                               class="btn btn-success btn-sm"
                               style="margin-left:8px; flex-shrink:0;">
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    }
    else
    {
        <!-- Partidos de fases eliminatorias genéricas -->
        @if (!PartidosEtapaActiva.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">🏆</div>
                <div class="empty-state-title">Sin partidos disponibles</div>
                <div class="empty-state-text">No hay partidos disponibles para esta etapa.</div>
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="table-card-header">
                    <span class="table-card-title">@EtapaActivaEtiqueta</span>
                    <span class="badge badge-green">@PartidosEtapaActiva.Count partidos</span>
                </div>
                @foreach (var partido in PartidosEtapaActiva)
                {
                    <div class="match-card">
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1;">
                            <div class="match-team @(partido.EstaJugado() && partido.Ganador() == partido.EquipoLocal ? "match-winner" : "")">
                                @(partido.EquipoLocal?.Nombre ?? "Por definir")
                            </div>
                            @if (partido.FueDefinidoPorPenales() && partido.GanadorPorPenales?.Id == partido.EquipoLocal?.Id)
                            {
                                <span class="badge badge-penalty" style="align-self:flex-start; margin-top:2px;">Ganador por penales</span>
                            }
                        </div>
                        <div class="match-score" style="flex-direction:column; gap:2px;">
                            @if (partido.EstaJugado())
                            {
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <span class="score-box">@partido.GolesLocal</span>
                                    <span class="score-sep">—</span>
                                    <span class="score-box">@partido.GolesVisitante</span>
                                </div>
                                @if (partido.FueDefinidoPorPenales())
                                {
                                    <span style="font-size:10px; color:rgb(251,146,60); font-weight:600; text-transform:uppercase; letter-spacing:0.06em; text-align:center;">pen.</span>
                                }
                            }
                            else
                            {
                                <span style="font-size:12px; color:var(--text-muted)">vs</span>
                            }
                        </div>
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1; align-items:flex-end;">
                            <div class="match-team right @(partido.EstaJugado() && partido.Ganador() == partido.EquipoVisitante ? "match-winner" : "")">
                                @(partido.EquipoVisitante?.Nombre ?? "Por definir")
                            </div>
                            @if (partido.FueDefinidoPorPenales() && partido.GanadorPorPenales?.Id == partido.EquipoVisitante?.Id)
                            {
                                <span class="badge badge-penalty" style="margin-top:2px;">Ganador por penales</span>
                            }
                        </div>
                        <div class="match-meta" style="margin-left:12px; min-width:110px; text-align:right">
                            @partido.Fecha.ToString("dd/MM/yy HH:mm")
                        </div>
                        @if (SesionServicio.PuedeEditarPartidos)
                        {
                            <button type="button"
                                    class="btn btn-warning btn-sm"
                                    disabled="@(!PuedeSimularPartido(partido))"
                                    style="margin-left:8px; flex-shrink:0"
                                    @onclick="() => SimularPartido(partido)">
                                Simular partido
                            </button>
                            <a href="/partidos/@partido.Id/editar" class="btn btn-success btn-sm" style="margin-left:8px; flex-shrink:0">
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                        }
                    </div>
                }
            </div>
        }
    }

    <div class="table-card mt-4" style="opacity:0.75">
        <div class="table-card-header">
            <span class="table-card-title">Configuración usada para generar el fixture</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Parámetro</th>
                    <th>Valor</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Fecha inicio torneo</td><td>@ConfiguracionUsadaParaFixture.FechaInicioTorneo.ToString("yyyy-MM-dd")</td></tr>
                <tr><td>Semilla fixture</td><td>@ConfiguracionUsadaParaFixture.SemillaFixture</td></tr>
                <tr><td>Semilla completar</td><td>@ConfiguracionUsadaParaFixture.SemillaCompletar</td></tr>
                <tr><td>Semilla cruces</td><td>@ConfiguracionUsadaParaFixture.SemillaCrucesFase</td></tr>
                <tr><td>Semilla simulación</td><td>@ConfiguracionUsadaParaFixture.SemillaSimulation</td></tr>
                <tr><td>Motor simulación</td><td>@ControladorSimulacion.ObtenerNombreMotor(ConfiguracionUsadaParaFixture.MotorSimulacion)</td></tr>
                <tr><td>Max partidos por día</td><td>@ConfiguracionUsadaParaFixture.MaxPartidosPorDia</td></tr>
                <tr><td>Separación entre fechas (días)</td><td>@ConfiguracionUsadaParaFixture.SeparacionEntreFechas</td></tr>
            </tbody>
        </table>
    </div>
}

@code {
    private string _error = string.Empty;
    private string _grupoActivo = "A";
    private FaseTorneo _etapaActiva = FaseTorneo.FaseDeGrupos;
    private int _jornadaActiva = ServicioFixture.PrimeraJornada;
    private bool _generando = false;
    private MotorSimulacion _motorSimulacionSeleccionado = MotorSimulacion.RankingActualYSemilla;

    protected override void OnInitialized()
    {
        if (!SesionServicio.HaySesion)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        SincronizarJornadaActivaConPendiente();
        _motorSimulacionSeleccionado = ControladorConfiguracionTorneo.ObtenerConfiguracionActualDTO().MotorSimulacion;
    }

    private static readonly List<EtapasTorneoHelper.EtapaTorneo> EtapasDisponibles =
        EtapasTorneoHelper.EtapasDisponibles;

    private FixtureDTO? FixtureActualDTO =>
        ControladorFixture.ObtenerFixtureDTO(EstadoTorneo);

    private List<GrupoDTO> GruposFixtureActual =>
        ControladorFixture.ObtenerGruposDTO(EstadoTorneo);

    private Grupo? GrupoSeleccionado =>
        EstadoTorneo.Fixture?.Grupos.FirstOrDefault(g => g.Etiqueta == _grupoActivo);

    private GrupoDTO? GrupoSeleccionadoDTO =>
        ControladorFixture.ObtenerGrupoDTO(EstadoTorneo, _grupoActivo);

    private IEnumerable<PosicionEquipoDTO> TablaGrupoSeleccionado =>
        GrupoSeleccionado == null
            ? Enumerable.Empty<PosicionEquipoDTO>()
            : ControladorClasificacion.CalcularTablaDTO(
                GrupoSeleccionado,
                ControladorConfiguracionTorneo.ObtenerConfiguracionActual());

    private string EtapaActivaEtiqueta =>
        EtapasDisponibles.FirstOrDefault(e => e.Fase == _etapaActiva)?.Etiqueta ?? string.Empty;

    private List<Partido> PartidosEtapaActiva =>
        EstadoTorneo.PartidosEliminatorios.Where(p => p.Fase == _etapaActiva).ToList();

    private Partido? PartidoFinal =>
        EstadoTorneo.PartidosEliminatorios.FirstOrDefault(p => p.Fase == FaseTorneo.Final);

    private Partido? PartidoTercerPuesto =>
        EstadoTorneo.PartidosEliminatorios.FirstOrDefault(p => p.Fase == FaseTorneo.TercerPuesto);

    private EquipoDTO? Campeon =>
        ControladorClasificacion.ObtenerCampeonDTO(PartidoFinal);

    private ConfiguracionTorneoDTO ConfiguracionUsadaParaFixture =>
        ControladorConfiguracionTorneo.ObtenerConfiguracionUsadaParaFixtureDTO();

    private void CrearNuevoTorneo()
    {
        _error = string.Empty;
        if (!PuedeModificarTorneo())
            return;

        _etapaActiva = FaseTorneo.FaseDeGrupos;
        _jornadaActiva = ServicioFixture.PrimeraJornada;
        ControladorFixture.CrearNuevoTorneo(EstadoTorneo);
        NavigationManager.NavigateTo("/fixture");
    }

    private void SeleccionarEtapa(FaseTorneo fase)
    {
        _etapaActiva = fase;
        SincronizarJornadaActivaConPendiente();
    }

    private void ManejarNavegacionTeclado(KeyboardEventArgs e, FaseTorneo fase)
    {
        var indice = EtapasDisponibles.FindIndex(et => et.Fase == fase);
        _etapaActiva = e.Key switch
        {
            "ArrowRight" when indice < EtapasDisponibles.Count - 1 => EtapasDisponibles[indice + 1].Fase,
            "ArrowLeft"  when indice > 0                           => EtapasDisponibles[indice - 1].Fase,
            "Home"                                                 => EtapasDisponibles[0].Fase,
            "End"                                                  => EtapasDisponibles[^1].Fase,
            _                                                      => _etapaActiva,
        };

        SincronizarJornadaActivaConPendiente();
    }

    private void GenerarFixture()
    {
        _error = string.Empty;
        if (!PuedeModificarTorneo())
            return;

        try
        {
            ControladorFixture.GenerarORegenerarFixture(_motorSimulacionSeleccionado, SesionServicio.UsuarioActual, EstadoTorneo);
            SincronizarJornadaActivaConPendiente();
            Toast.Exito("Fixture generado correctamente.");
        }
        catch (Exception ex) { _error = MensajeErrorHelper.ParaUsuario(ex); }
    }

    private void SimularPartido(Partido? partido)
    {
        if (!PuedeModificarTorneo())
            return;

        if (partido == null || !PuedeSimularPartido(partido))
        {
            _error = "Solo se puede simular el próximo partido pendiente del calendario.";
            return;
        }

        SimularPartidos(new List<Partido> { partido }, "Partido simulado correctamente.");
    }

    private void SimularJornadaOFecha()
    {
        if (!PuedeModificarTorneo())
            return;

        SimularPartidos(
            ObtenerPartidosJornadaOFechaActual(),
            ControladorFixture.ObtenerMensajeExitoSimulacion(_etapaActiva));
    }

    private void SimularFaseActiva()
    {
        if (!PuedeModificarTorneo())
            return;

        SimularPartidos(
            ObtenerPartidosPendientesEtapaActiva(),
            "Fase simulada correctamente.");
    }

    private void SimularPartidos(List<Partido> partidos, string mensajeExito)
    {
        _error = string.Empty;
        if (!PuedeModificarTorneo())
            return;

        try
        {
            var config = ControladorConfiguracionTorneo.ObtenerConfiguracionUsadaParaFixture();
            ControladorSimulacion.SimularYPersistirPartidos(partidos, config, SesionServicio.UsuarioActual, EstadoTorneo);
            SincronizarJornadaActivaConPendiente();
            Toast.Exito(mensajeExito);
        }
        catch (Exception ex)
        {
            _error = MensajeErrorHelper.ParaUsuario(ex);
        }
    }

    private bool PuedeModificarTorneo()
    {
        if (SesionServicio.PuedeEditarPartidos)
            return true;

        _error = "No tenés permisos para modificar partidos o fixture.";
        return false;
    }

    private bool EsEtapaActivaSimulable =>
        ControladorFixture.ObtenerFaseActualSimulable(EstadoTorneo) == _etapaActiva;

    private bool PuedeSimularPartido(Partido? partido) =>
        SesionServicio.PuedeEditarPartidos
        && ControladorFixture.EsPartidoSimulable(partido, EstadoTorneo, _etapaActiva);

    private bool PuedeSimularJornadaOFecha()
    {
        return SesionServicio.PuedeEditarPartidos && ObtenerPartidosJornadaOFechaActual().Any();
    }

    private bool PuedeSimularFaseActiva()
    {
        return SesionServicio.PuedeEditarPartidos && ObtenerPartidosPendientesEtapaActiva().Any();
    }

    private List<Partido> ObtenerPartidosPendientesEtapaActiva() =>
        ControladorFixture.ObtenerPartidosPendientesEtapaActiva(EstadoTorneo, _etapaActiva);

    private List<Partido> ObtenerPartidosJornadaOFechaActual() =>
        ControladorFixture.ObtenerPartidosJornadaOFechaActual(EstadoTorneo, _etapaActiva, _jornadaActiva);

    private Partido? ObtenerProximoPartidoSimulable() =>
        ControladorFixture.ObtenerProximoPartidoSimulable(EstadoTorneo, _etapaActiva);

    private Partido? ObtenerPartidoDominio(PartidoDTO partido) =>
        EstadoTorneo.Fixture?.Partidos.FirstOrDefault(p => p.Id == partido.Id)
        ?? EstadoTorneo.PartidosEliminatorios.FirstOrDefault(p => p.Id == partido.Id);

    private void SincronizarJornadaActivaConPendiente()
    {
        var jornada = ControladorFixture.ObtenerJornadaActivaParaFase(_etapaActiva, EstadoTorneo.Fixture);
        if (jornada.HasValue)
            _jornadaActiva = jornada.Value;
    }

    private string MensajeCondicionFaseActiva =>
        EstadoTorneo.Fixture == null
            ? string.Empty
            : ControladorFixture.ObtenerMensajeCondicionFase(_etapaActiva, EstadoTorneo);

    private async Task GenerarFaseActiva()
    {
        if (!PuedeModificarTorneo()) return;
        _error = string.Empty;
        _generando = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            ControladorFaseEliminatoria.GenerarFase(_etapaActiva, EstadoTorneo);
            Toast.Exito(ControladorFixture.ObtenerMensajeExitoGeneracionFase(_etapaActiva));
        }
        catch (Exception ex) { _error = MensajeErrorHelper.ParaUsuario(ex); }
        finally { _generando = false; }
    }

}
