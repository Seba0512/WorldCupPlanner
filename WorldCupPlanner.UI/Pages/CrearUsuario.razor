@page "/usuarios/crear"
@using WorldCupPlanner.Controladores
@inject ControladorUsuario ControladorUsuario
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<GuardiaAdmin>
<PageTitle>Nuevo usuario — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Nuevo usuario" UrlVolver="/usuarios" TextoVolver="Volver a usuarios" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
            @if (_erroresCampos.Count > 0)
            {
                <ul class="mb-0 mt-1">
                    @foreach (var item in _erroresCampos)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </div>
    }

    <div class="row g-3">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="form-label">Nombre <span style="color:red">*</span></label>
                <input type="text" class="form-control" @bind="_nombre" placeholder="Juan" />
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="form-label">Apellido <span style="color:red">*</span></label>
                <input type="text" class="form-control" @bind="_apellido" placeholder="García" />
            </div>
        </div>
    </div>

    <div class="form-group">
        <label class="form-label">Correo electrónico <span style="color:red">*</span></label>
        <input type="email" class="form-control @(_emailConError ? "is-invalid" : string.Empty)"
               @bind="_email" @oninput="() => _emailConError = false" placeholder="usuario@ejemplo.com" />
        @if (_emailConError)
        {
            <div class="invalid-feedback">@_error</div>
        }
    </div>

    <div class="form-group">
        <label class="form-label">Fecha de nacimiento <span style="color:red">*</span></label>
        <input type="date" class="form-control" @bind="_fechaNacimiento" />
    </div>

    <div class="form-group">
        <label class="form-label">Contraseña <span style="color:red">*</span></label>
        <input type="password" class="form-control" @bind="_contrasenia" placeholder="••••••••" />
        <span class="form-hint">Mínimo 8 caracteres. Debe incluir mayúscula, minúscula, número y carácter especial.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Confirmar contraseña <span style="color:red">*</span></label>
        <input type="password" class="form-control" @bind="_confirmarContrasenia" placeholder="••••••••" />
    </div>

    <div class="form-group">
        <label class="form-label">Roles</label>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="chkAdmin" @bind="_esAdmin" />
            <label class="form-check-label" for="chkAdmin">
                <span class="badge badge-blue" style="margin-right:6px">Admin</span>
                Administrador del Sistema
            </label>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="chkEditor" @bind="_esEditor" />
            <label class="form-check-label" for="chkEditor">
                <span class="badge badge-gold" style="margin-right:6px">Editor</span>
                Editor
            </label>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="chkPeriodista" @bind="_esPeriodista" />
            <label class="form-check-label" for="chkPeriodista">
                <span class="badge badge-green" style="margin-right:6px">Periodista</span>
                Periodista
            </label>
        </div>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar">
            <span class="oi oi-check" aria-hidden="true"></span> Crear usuario
        </button>
        <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
    </div>
</div>
</GuardiaAdmin>

@code {
    private string _nombre = string.Empty;
    private string _apellido = string.Empty;
    private string _email = string.Empty;
    private DateTime _fechaNacimiento = DateTime.Now.AddYears(-18);
    private string _contrasenia = string.Empty;
    private string _confirmarContrasenia = string.Empty;
    private bool _esAdmin;
    private bool _esEditor = true;
    private bool _esPeriodista;
    private string _error = string.Empty;
    private List<string> _erroresCampos = [];
    private bool _emailConError;

    private static readonly System.Text.RegularExpressions.Regex PatronEmail =
        new(@"^[^\s@]+@[^\s@]+\.[^\s@]+$");

    private void Guardar()
    {
        _error = string.Empty;
        _erroresCampos = [];
        _emailConError = false;

        var camposInvalidos = ValidarCampos();
        if (camposInvalidos.Count == 1)
        {
            _error = MensajeLargoParaCampo(camposInvalidos[0]);
            return;
        }
        if (camposInvalidos.Count > 1)
        {
            _error = "No se pudo crear el usuario. Por favor, revisá los siguientes campos:";
            _erroresCampos = camposInvalidos.Select(MensajeCortoParaCampo).ToList();
            return;
        }

        try
        {
            var roles = UsuarioFormHelper.ConstruirRoles(_esAdmin, _esEditor, _esPeriodista);

            ControladorUsuario.Crear(new NuevoUsuarioFormulario
            {
                Nombre = _nombre,
                Apellido = _apellido,
                Email = _email,
                FechaNacimiento = _fechaNacimiento,
                Contrasenia = _contrasenia,
                ConfirmarContrasenia = _confirmarContrasenia,
                Roles = roles
            }, ejecutadoPor: SesionServicio.UsuarioActual?.Email);

            Toast.Exito($"Usuario \"{_nombre} {_apellido}\" creado correctamente.");
            NavigationManager.NavigateTo("/usuarios");
        }
        catch (EntidadYaExistenteExcepcion ex) { _error = ex.Message; _emailConError = true; }
        catch (Exception ex) { _error = MensajeErrorHelper.ParaUsuario(ex); }
    }

    private List<string> ValidarCampos()
    {
        var errores = new List<string>();
        if (string.IsNullOrWhiteSpace(_nombre))
            errores.Add("nombre");
        if (string.IsNullOrWhiteSpace(_apellido))
            errores.Add("apellido");
        if (string.IsNullOrWhiteSpace(_email))
            errores.Add("email_vacio");
        else if (!PatronEmail.IsMatch(_email))
            errores.Add("email_formato");
        if (string.IsNullOrWhiteSpace(_contrasenia))
            errores.Add("contrasenia");
        else if (_contrasenia != _confirmarContrasenia)
            errores.Add("contrasenia_no_coincide");
        return errores;
    }

    private static string MensajeLargoParaCampo(string campo) => campo switch
    {
        "nombre"                  => "El nombre del usuario es obligatorio. Por favor, ingresá el nombre antes de guardar.",
        "apellido"                => "El apellido del usuario es obligatorio. Por favor, ingresá el apellido antes de guardar.",
        "email_vacio"             => "El correo electrónico es obligatorio. Por favor, ingresá una dirección de email antes de guardar.",
        "email_formato"           => "El correo electrónico ingresado no tiene un formato válido. Usá el formato usuario@dominio.com.",
        "contrasenia"             => "La contraseña es obligatoria. Por favor, ingresá una contraseña antes de guardar.",
        "contrasenia_no_coincide" => "Las contraseñas no coinciden. Asegurate de ingresar la misma contraseña en ambos campos.",
        _                         => "El usuario no es válido."
    };

    private static string MensajeCortoParaCampo(string campo) => campo switch
    {
        "nombre"                  => "El nombre del usuario es obligatorio.",
        "apellido"                => "El apellido del usuario es obligatorio.",
        "email_vacio"             => "El correo electrónico es obligatorio.",
        "email_formato"           => "El correo electrónico no tiene un formato válido.",
        "contrasenia"             => "La contraseña es obligatoria.",
        "contrasenia_no_coincide" => "Las contraseñas no coinciden.",
        _                         => "Campo inválido."
    };
}
