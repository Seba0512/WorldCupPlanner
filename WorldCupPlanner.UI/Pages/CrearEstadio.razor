@page "/estadios/crear"
@inject ServicioEstadio ServicioEstadio
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Nuevo estadio — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Nuevo estadio" UrlVolver="/estadios" TextoVolver="Volver a estadios" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
        </div>
    }

    <div class="form-group">
        <label class="form-label">Nombre</label>
        <input type="text" class="form-control" @bind="_estadio.Nombre" maxlength="80" placeholder="Ej: Estadio Metropolitano" />
        <span class="form-hint">1–80 caracteres. Debe ser único.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Ciudad</label>
        <input type="text" class="form-control" @bind="_estadio.Ciudad" maxlength="60" placeholder="Ej: Madrid" />
    </div>

    <div class="form-group">
        <label class="form-label">Capacidad de público</label>
        <input type="number" class="form-control" @bind="_estadio.Capacidad" min="20000" placeholder="Ej: 75000" />
        <span class="form-hint">Mínimo 20.000 espectadores.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Descripción <span style="color:var(--text-muted)">(opcional)</span></label>
        <textarea class="form-control" @bind="_estadio.Descripcion" maxlength="400" rows="3"
                  placeholder="Descripción breve del estadio..."></textarea>
        <span class="form-hint">Hasta 400 caracteres.</span>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar
        </button>
        <a href="/estadios" class="btn btn-secondary">Cancelar</a>
    </div>
</div>

@code {
    private Estadio _estadio = new();
    private string _error = string.Empty;

    protected override void OnInitialized()
    {
        if (!SesionServicio.EsAdministrador) NavigationManager.NavigateTo("/");
    }

    private void Guardar()
    {
        _error = string.Empty;
        try
        {
            ServicioEstadio.AgregarEstadio(_estadio);
            Toast.Exito($"Estadio \"{_estadio.Nombre}\" creado correctamente.");
            NavigationManager.NavigateTo("/estadios");
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
