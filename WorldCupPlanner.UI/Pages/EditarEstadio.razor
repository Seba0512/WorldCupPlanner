@page "/estadios/{Nombre}/editar"
@inject ServicioEstadio ServicioEstadio
@inject EstadoTorneo EstadoTorneo
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Editar estadio — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Editar estadio" UrlVolver="/estadios" TextoVolver="Volver a estadios" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
        </div>
    }
    @if (_edicionBloqueada)
    {
        <div class="alert alert-warning">
            <span class="oi oi-warning" aria-hidden="true"></span>
            No se puede editar un estadio que participa en el fixture generado.
        </div>
    }

    <div class="form-group">
        <label class="form-label">Nombre</label>
        <input type="text" class="form-control" @bind="_estadio.Nombre" maxlength="80" disabled="@_edicionBloqueada" />
    </div>

    <div class="form-group">
        <label class="form-label">Ciudad</label>
        <input type="text" class="form-control" @bind="_estadio.Ciudad" maxlength="60" disabled="@_edicionBloqueada" />
    </div>

    <div class="form-group">
        <label class="form-label">Capacidad de público</label>
        <input type="number" class="form-control"
               @bind:get="_capacidad"
               @bind:set="v => { _capacidad = v; _estadio.Capacidad = v ?? 0; }"
               min="20000" placeholder="Ej: 75000" disabled="@_edicionBloqueada" />
        <span class="form-hint">Mínimo 20.000 espectadores.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Descripción <span style="color:var(--text-muted)">(opcional)</span></label>
        <textarea class="form-control" @bind="_estadio.Descripcion" maxlength="400" rows="3" disabled="@_edicionBloqueada"></textarea>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@_edicionBloqueada">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar cambios
        </button>
        <a href="/estadios" class="btn btn-secondary">Cancelar</a>
    </div>
</div>

@code {
    [Parameter] public string Nombre { get; set; } = string.Empty;
    private Estadio _estadio = new();
    private int? _capacidad;
    private string _error = string.Empty;
    private bool _edicionBloqueada;

    protected override void OnInitialized()
    {
        if (!SesionServicio.EsAdministrador) { NavigationManager.NavigateTo("/"); return; }
        var original = ServicioEstadio.ObtenerPorNombre(Nombre);
        _estadio = ServicioEstadio.ClonarParaEdicion(Nombre);
        _capacidad = _estadio.Capacidad;
        _edicionBloqueada = EstadoTorneo.EstadioParticipaEnFixture(original);
    }

    private void Guardar()
    {
        _error = string.Empty;
        if (_edicionBloqueada)
        {
            _error = "No se puede editar un estadio que participa en el fixture generado.";
            return;
        }
        try
        {
            ServicioEstadio.EditarEstadio(Nombre, _estadio, SesionServicio.UsuarioActual);
            Toast.Exito("Estadio actualizado correctamente.");
            NavigationManager.NavigateTo("/estadios");
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
