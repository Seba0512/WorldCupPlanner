@page "/estadios/{Nombre}/editar"
@inject ServicioEstadio ServicioEstadio
@inject EstadoTorneo EstadoTorneo
@inject ServicioConsultasTorneo ServicioConsultasTorneo
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<GuardiaAdmin>
<PageTitle>Editar estadio — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Editar estadio" UrlVolver="/estadios" TextoVolver="Volver a estadios" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
            @if (_erroresCampos.Count > 0)
            {
                <ul class="mb-0 mt-1">
                    @foreach (var item in _erroresCampos)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </div>
    }
    @if (_edicionBloqueada)
    {
        <div class="alert alert-warning">
            <span class="oi oi-warning" aria-hidden="true"></span>
            No se puede editar un estadio que participa en el fixture generado.
        </div>
    }

    <div class="form-group">
        <label class="form-label">Nombre <span style="color:red">*</span></label>
        <input type="text" class="form-control" @bind="_estadio.Nombre" maxlength="80" disabled="@_edicionBloqueada" />
    </div>

    <div class="form-group">
        <label class="form-label">Ciudad <span style="color:red">*</span></label>
        <input type="text" class="form-control" @bind="_estadio.Ciudad" maxlength="60" disabled="@_edicionBloqueada" />
    </div>

    <div class="form-group">
        <label class="form-label">Capacidad de público <span style="color:red">*</span></label>
        <input type="number" class="form-control"
               @bind:get="_capacidad"
               @bind:set="v => { _capacidad = v; _estadio.Capacidad = v ?? 0; }"
               min="20000" placeholder="Ej: 75000" disabled="@_edicionBloqueada" />
        <span class="form-hint">Mínimo 20.000 espectadores.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Descripción <span style="color:var(--text-muted)">(opcional)</span></label>
        <textarea class="form-control" @bind="_estadio.Descripcion" maxlength="400" rows="3" disabled="@_edicionBloqueada"></textarea>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@_edicionBloqueada">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar cambios
        </button>
        <a href="/estadios" class="btn btn-secondary">Cancelar</a>
    </div>
</div>
</GuardiaAdmin>

@code {
    [Parameter] public string Nombre { get; set; } = string.Empty;
    private Estadio _estadio = new();
    private int? _capacidad;
    private string _error = string.Empty;
    private List<string> _erroresCampos = [];
    private bool _edicionBloqueada;

    protected override void OnInitialized()
    {
        var original = ServicioEstadio.ObtenerPorNombre(Nombre);
        _estadio = ServicioEstadio.ClonarParaEdicion(Nombre);
        _capacidad = _estadio.Capacidad;
        _edicionBloqueada = ServicioConsultasTorneo.EstadioParticipaEnFixture(EstadoTorneo, original);
    }

    private void Guardar()
    {
        _error = string.Empty;
        _erroresCampos = [];

        if (_edicionBloqueada)
        {
            _error = "No se puede editar un estadio que participa en el fixture generado.";
            return;
        }

        var camposInvalidos = ValidarCampos();
        if (camposInvalidos.Count == 1)
        {
            _error = MensajeLargoParaCampo(camposInvalidos[0]);
            return;
        }
        if (camposInvalidos.Count > 1)
        {
            _error = "No se pudo guardar el estadio. Por favor, revisá los siguientes campos:";
            _erroresCampos = camposInvalidos.Select(MensajeCortoParaCampo).ToList();
            return;
        }

        try
        {
            ServicioEstadio.EditarEstadio(Nombre, _estadio, SesionServicio.UsuarioActual);
            Toast.Exito("Estadio actualizado correctamente.");
            NavigationManager.NavigateTo("/estadios");
        }
        catch (Exception ex) { _error = MensajeErrorHelper.ParaUsuario(ex); }
    }

    private List<string> ValidarCampos()
    {
        var errores = new List<string>();
        if (string.IsNullOrWhiteSpace(_estadio.Nombre))
            errores.Add("nombre");
        if (string.IsNullOrWhiteSpace(_estadio.Ciudad))
            errores.Add("ciudad");
        if (_capacidad == null || _capacidad < 20000)
            errores.Add("capacidad");
        return errores;
    }

    private static string MensajeLargoParaCampo(string campo) => campo switch
    {
        "nombre"    => "El nombre del estadio es obligatorio. Por favor, ingresá un nombre antes de guardar.",
        "ciudad"    => "La ciudad es un campo obligatorio. Por favor, ingresá la ciudad del estadio.",
        "capacidad" => "La capacidad del estadio debe ser de al menos 20.000 espectadores. El valor ingresado no cumple con el mínimo requerido.",
        _           => "El estadio no es válido."
    };

    private static string MensajeCortoParaCampo(string campo) => campo switch
    {
        "nombre"    => "El nombre del estadio es obligatorio.",
        "ciudad"    => "La ciudad es un campo obligatorio.",
        "capacidad" => "La capacidad debe ser de al menos 20.000 espectadores.",
        _           => "Campo inválido."
    };
}
