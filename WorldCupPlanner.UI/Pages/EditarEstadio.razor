@page "/estadios/{Nombre}/editar"
@inject ServicioEstadio ServicioEstadio
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Editar estadio — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Editar estadio" UrlVolver="/estadios" TextoVolver="Volver a estadios" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
        </div>
    }

    <div class="form-group">
        <label class="form-label">Nombre</label>
        <input type="text" class="form-control" @bind="_estadio.Nombre" maxlength="80" />
    </div>

    <div class="form-group">
        <label class="form-label">Ciudad</label>
        <input type="text" class="form-control" @bind="_estadio.Ciudad" maxlength="60" />
    </div>

    <div class="form-group">
        <label class="form-label">Capacidad de público</label>
        <input type="number" class="form-control" @bind="_estadio.Capacidad" min="20000" />
        <span class="form-hint">Mínimo 20.000 espectadores.</span>
    </div>

    <div class="form-group">
        <label class="form-label">Descripción <span style="color:var(--text-muted)">(opcional)</span></label>
        <textarea class="form-control" @bind="_estadio.Descripcion" maxlength="400" rows="3"></textarea>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar cambios
        </button>
        <a href="/estadios" class="btn btn-secondary">Cancelar</a>
    </div>
</div>

@code {
    [Parameter] public string Nombre { get; set; } = string.Empty;
    private Estadio _estadio = new();
    private string _error = string.Empty;

    protected override void OnInitialized()
    {
        if (!SesionServicio.EsAdministrador) { NavigationManager.NavigateTo("/"); return; }
        var original = ServicioEstadio.ObtenerEstadios().First(e => e.Nombre == Nombre);
        _estadio = new Estadio { Nombre = original.Nombre, Ciudad = original.Ciudad, Capacidad = original.Capacidad, Descripcion = original.Descripcion };
    }

    private void Guardar()
    {
        _error = string.Empty;
        try
        {
            ServicioEstadio.EditarEstadio(Nombre, _estadio);
            Toast.Exito("Estadio actualizado correctamente.");
            NavigationManager.NavigateTo("/estadios");
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
