@page "/usuarios"
@inject ServicioUsuario ServicioUsuario
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Usuarios — WorldCupPlanner 2026</PageTitle>

<ConfirmDialog @bind-Visible="_confirmarEliminar"
               Titulo="Eliminar usuario"
               Mensaje="@($"¿Eliminás al usuario \"{_usuarioAEliminar?.Email}\"?")"
               OnConfirmar="ConfirmarEliminar" />

<PageHeader Titulo="Usuarios" Subtitulo="@($"{_usuarios.Count} usuarios en el sistema")">
    <AccionesContent>
        <a href="/usuarios/crear" class="btn btn-primary btn-sm">
            <span class="oi oi-plus" aria-hidden="true"></span> Agregar usuario
        </a>
    </AccionesContent>
</PageHeader>

<div class="table-card">
    @if (_usuarios.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">👤</div>
            <div class="empty-state-title">No hay usuarios adicionales</div>
            <div class="empty-state-text">Creá usuarios con roles de Administrador o Editor.</div>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in _usuarios)
                {
                    <tr>
                        <td>
                            <div style="font-weight:600">@usuario.Nombre @usuario.Apellido</div>
                        </td>
                        <td style="color:var(--text-secondary)">@usuario.Email</td>
                        <td>
                            @foreach (var rol in usuario.ObtenerRoles())
                            {
                                <span class="badge @(rol == RolUsuario.AdministradorDelSistema ? "badge-blue" : "badge-gold")" style="margin-right:4px">
                                    @(rol == RolUsuario.AdministradorDelSistema ? "Admin" : "Editor")
                                </span>
                            }
                        </td>
                        <td style="width:120px; text-align:right">
                            <a href="/usuarios/@usuario.Email/editar" class="btn btn-success btn-sm">
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => PedirConfirmacion(usuario)"
                                    disabled="@EsUltimoAdministrador(usuario)"
                                    title="@(EsUltimoAdministrador(usuario) ? "No es posible eliminar el último administrador del sistema" : "Eliminar usuario")">
                                <span class="oi oi-trash" aria-hidden="true"></span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Usuario> _usuarios = new();
    private Usuario? _usuarioAEliminar;
    private bool _confirmarEliminar;

    protected override void OnInitialized()
    {
        if (!SesionServicio.EsAdministrador) { NavigationManager.NavigateTo("/"); return; }
        _usuarios = ServicioUsuario.ObtenerTodosLosUsuarios();
    }

    private void PedirConfirmacion(Usuario usuario)
    {
        _usuarioAEliminar = usuario;
        _confirmarEliminar = true;
    }

    private void ConfirmarEliminar()
    {
        if (_usuarioAEliminar == null) return;
        try
        {
            ServicioUsuario.EliminarUsuario(_usuarioAEliminar);
            Toast.Exito("Usuario eliminado correctamente.");
            _usuarioAEliminar = null;
            _usuarios = ServicioUsuario.ObtenerTodosLosUsuarios();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private bool EsUltimoAdministrador(Usuario usuario)
    {
        if (!usuario.TieneRol(RolUsuario.AdministradorDelSistema)) return false;
        return _usuarios.Count(u => u.TieneRol(RolUsuario.AdministradorDelSistema)) == 1;
    }
}
