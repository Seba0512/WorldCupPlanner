@page "/estadios"
@inject ServicioEstadio ServicioEstadio
@inject EstadoTorneo EstadoTorneo
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Estadios — WorldCupPlanner 2026</PageTitle>

<ConfirmDialog @bind-Visible="_confirmarEliminar"
               Titulo="Eliminar estadio"
               Mensaje="@($"¿Eliminás el estadio \"{_estadioAEliminar?.Nombre}\"?")"
               OnConfirmar="ConfirmarEliminar" />

<PageHeader Titulo="Estadios" Subtitulo="@($"{_estadios.Count} estadios registrados")">
    <AccionesContent>
        <a href="/estadios/crear" class="btn btn-primary btn-sm">
            <span class="oi oi-plus" aria-hidden="true"></span> Agregar estadio
        </a>
    </AccionesContent>
</PageHeader>

@if (EstadoTorneo.Fixture != null)
{
    <div class="alert alert-warning mb-3">
        <span class="oi oi-warning" aria-hidden="true"></span>
        No se pueden editar estadios que participan en el fixture generado.
    </div>
}

<div class="table-card">
    @if (_estadios.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🏟️</div>
            <div class="empty-state-title">No hay estadios registrados</div>
            <div class="empty-state-text">Necesitás al menos 4 estadios para generar el fixture.</div>
            <a href="/estadios/crear" class="btn btn-primary">
                <span class="oi oi-plus" aria-hidden="true"></span> Agregar estadio
            </a>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Ciudad</th>
                    <th>Capacidad</th>
                    <th>Descripción</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var estadio in _estadios)
                {
                    var estadioBloqueadoPorFixture = EstadioParticipaEnFixture(estadio);
                    <tr>
                        <td style="font-weight:600">@estadio.Nombre</td>
                        <td>@estadio.Ciudad</td>
                        <td style="font-family:var(--font-heading); font-weight:700">
                            @estadio.Capacidad.ToString("N0")
                        </td>
                        <td style="color:var(--text-secondary); max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                            @(string.IsNullOrEmpty(estadio.Descripcion) ? "—" : estadio.Descripcion)
                        </td>
                        <td style="width:120px; text-align:right">
                            @if (estadioBloqueadoPorFixture)
                            {
                                <button type="button"
                                        class="btn btn-success btn-sm"
                                        disabled
                                        title="No se puede editar un estadio que participa en el fixture generado.">
                                    <span class="oi oi-pencil" aria-hidden="true"></span>
                                </button>
                            }
                            else
                            {
                                <a href="/estadios/@estadio.Nombre/editar" class="btn btn-success btn-sm">
                                    <span class="oi oi-pencil" aria-hidden="true"></span>
                                </a>
                            }
                            <button class="btn btn-danger btn-sm" @onclick="() => PedirConfirmacion(estadio)">
                                <span class="oi oi-trash" aria-hidden="true"></span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Estadio> _estadios = new();
    private Estadio? _estadioAEliminar;
    private bool _confirmarEliminar;

    protected override void OnInitialized()
    {
        if (!SesionServicio.EsAdministrador) { NavigationManager.NavigateTo("/"); return; }
        _estadios = ServicioEstadio.ObtenerEstadios();
    }

    private void PedirConfirmacion(Estadio estadio)
    {
        _estadioAEliminar = estadio;
        _confirmarEliminar = true;
    }

    private void ConfirmarEliminar()
    {
        if (_estadioAEliminar == null) return;
        try
        {
            ServicioEstadio.EliminarEstadio(_estadioAEliminar, SesionServicio.UsuarioActual);
            Toast.Exito($"Estadio \"{_estadioAEliminar.Nombre}\" eliminado.");
            _estadioAEliminar = null;
            _estadios = ServicioEstadio.ObtenerEstadios();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private bool EstadioParticipaEnFixture(Estadio estadio)
    {
        if (EstadoTorneo.Fixture == null)
            return false;

        return EstadoTorneo.Fixture.Partidos
                   .Any(p => EsMismoEstadio(p.Estadio, estadio))
               || EstadoTorneo.PartidosEliminatorios
                   .Any(p => EsMismoEstadio(p.Estadio, estadio));
    }

    private static bool EsMismoEstadio(Estadio? estadioEnFixture, Estadio estadio)
    {
        if (estadioEnFixture == null)
            return false;

        if (estadioEnFixture.Id > 0 && estadio.Id > 0)
            return estadioEnFixture.Id == estadio.Id;

        return string.Equals(estadioEnFixture.Nombre, estadio.Nombre, StringComparison.OrdinalIgnoreCase);
    }
}
