@page "/login"
@layout LoginLayout
@using WorldCupPlanner.Controladores
@inject ControladorUsuario ControladorUsuario
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager

<PageTitle>Iniciar sesión — WorldCupPlanner 2026</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <div class="login-brand-icon">⚽</div>
        <h1 class="login-brand-title">WorldCupPlanner</h1>
        <p class="login-brand-subtitle">Tournament Intelligence 2026</p>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span>
            @_error
        </div>
    }

    <div class="form-group">
        <label class="form-label">Correo electrónico</label>
        <input type="email" class="form-control" @bind="_email" @onkeydown="TeclaPresionada"
               placeholder="usuario@ejemplo.com" />
    </div>
    <div class="form-group">
        <label class="form-label">Contraseña</label>
        <input type="password" class="form-control" @bind="_contrasenia" @onkeydown="TeclaPresionada"
               placeholder="••••••••" />
    </div>

    <button type="button" class="btn btn-primary w-100 mt-2" @onclick="IniciarSesion">
        <span class="oi oi-account-login" aria-hidden="true"></span>
        Ingresar
    </button>
</div>

<AyudaCredenciales />

@code {
    private string _email = string.Empty;
    private string _contrasenia = string.Empty;
    private string _error = string.Empty;

    private void IniciarSesion()
    {
        _error = string.Empty;
        try
        {
            var usuario = ControladorUsuario.Login(_email, _contrasenia);
            SesionServicio.IniciarSesion(usuario);
            NavigationManager.NavigateTo(usuario.DebeCambiarContrasenia ? "/cuenta/cambiar-contrasenia" : "/");
        }
        catch (Exception ex)
        {
            _error = MensajeErrorHelper.ParaUsuario(ex);
        }
    }

    private void TeclaPresionada(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") IniciarSesion();
    }
}
