@page "/usuarios/{Email}/editar"
@inject ServicioUsuario ServicioUsuario
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Editar usuario — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Editar usuario" UrlVolver="/usuarios" TextoVolver="Volver a usuarios" />

<div class="form-section">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <span class="oi oi-warning" aria-hidden="true"></span> @_error
        </div>
    }

    <div class="row g-3">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="form-label">Nombre</label>
                <input type="text" class="form-control" @bind="_nombre" />
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="form-label">Apellido</label>
                <input type="text" class="form-control" @bind="_apellido" />
            </div>
        </div>
    </div>

    <div class="form-group">
        <label class="form-label">Correo electrónico</label>
        <input type="email" class="form-control" @bind="_email" />
    </div>

    <div class="form-group">
        <label class="form-label">Fecha de nacimiento</label>
        <input type="date" class="form-control" @bind="_fechaNacimiento" />
    </div>

    <div class="form-group">
        <label class="form-label">Roles</label>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="chkAdmin" @bind="_esAdmin" />
            <label class="form-check-label" for="chkAdmin">
                <span class="badge badge-blue" style="margin-right:6px">Admin</span>
                Administrador del Sistema
            </label>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="chkEditor" @bind="_esEditor" />
            <label class="form-check-label" for="chkEditor">
                <span class="badge badge-gold" style="margin-right:6px">Editor</span>
                Editor
            </label>
        </div>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" @onclick="Guardar">
            <span class="oi oi-check" aria-hidden="true"></span> Guardar cambios
        </button>
        <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
    </div>
</div>

@code {
    [Parameter] public string Email { get; set; } = string.Empty;
    private Usuario? _usuario;
    private string _nombre = string.Empty;
    private string _apellido = string.Empty;
    private string _email = string.Empty;
    private DateTime _fechaNacimiento = DateTime.Now.AddYears(-18);
    private bool _esAdmin;
    private bool _esEditor;
    private string _error = string.Empty;

    protected override void OnInitialized()
    {
        if (!SesionServicio.EsAdministrador) { NavigationManager.NavigateTo("/"); return; }
        _usuario = ServicioUsuario.ObtenerPorEmail(Email);
        if (_usuario != null)
        {
            _nombre          = _usuario.Nombre;
            _apellido        = _usuario.Apellido;
            _email           = _usuario.Email;
            _fechaNacimiento = _usuario.FechaNacimiento;
            _esAdmin         = _usuario.TieneRol(RolUsuario.AdministradorDelSistema);
            _esEditor        = _usuario.TieneRol(RolUsuario.Editor);
        }
    }

    private void Guardar()
    {
        _error = string.Empty;
        try
        {
            if (_usuario == null) return;
            if (_esAdmin) _usuario.AgregarRol(RolUsuario.AdministradorDelSistema);
            else _usuario.RemoverRol(RolUsuario.AdministradorDelSistema);
            if (_esEditor) _usuario.AgregarRol(RolUsuario.Editor);
            else _usuario.RemoverRol(RolUsuario.Editor);
            ServicioUsuario.ActualizarUsuario(_usuario, new ActualizacionUsuario
            {
                Nombre = _nombre, Apellido = _apellido,
                Email = _email, FechaNacimiento = _fechaNacimiento.ToString("MM-dd-yyyy")
            });
            Toast.Exito("Usuario actualizado correctamente.");
            NavigationManager.NavigateTo("/usuarios");
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
