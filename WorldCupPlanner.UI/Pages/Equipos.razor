@page "/equipos"
@inject ServicioEquipo ServicioEquipo
@inject EstadoTorneo EstadoTorneo
@inject ServicioConfiguracionTorneo ServicioConfiguracionTorneo
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Equipos — WorldCupPlanner 2026</PageTitle>

@if (!string.IsNullOrEmpty(_errorCarga))
{
    <div class="alert alert-danger mb-3">
        <span class="oi oi-warning" aria-hidden="true"></span>
        <strong>Error al cargar los equipos:</strong> @_errorCarga
        <button class="btn btn-sm btn-outline-light ms-3" @onclick="Reintentar">
            <span class="oi oi-reload" aria-hidden="true"></span> Reintentar
        </button>
    </div>
}

<ConfirmDialog @bind-Visible="_confirmarEliminar"
               Titulo="Eliminar equipo"
               Mensaje="@($"¿Eliminás el equipo \"{_equipoAEliminar?.Nombre}\"? Esta acción no se puede deshacer.")"
               OnConfirmar="ConfirmarEliminar" />

<PageHeader Titulo="Equipos" Subtitulo="@($"{_equipos.Count} de 48 equipos registrados")">
    <AccionesContent>
        @if (SesionServicio.PuedeGestionarEquipos)
        {
            <a href="/equipos/crear" class="btn btn-primary btn-sm">
                <span class="oi oi-plus" aria-hidden="true"></span> Agregar equipo
            </a>
        }
    </AccionesContent>
</PageHeader>

<!-- Confederaciones resumen -->
<div class="row g-2 mb-4">
    @foreach (var conf in _cuposPorConfederacion)
    {
        <div class="col-auto">
            <div class="glass-card" style="padding: 10px 16px; text-align:center; min-width:90px;">
                <div style="font-size:11px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:var(--text-muted)">@conf.Key</div>
                <div style="font-family:var(--font-heading); font-size:18px; font-weight:700; color:var(--text-primary);">@conf.Value.registrados</div>
                <div style="font-size:11px; color:var(--text-secondary);">/ @conf.Value.cupo cupos</div>
            </div>
        </div>
    }
</div>

@if (SesionServicio.PuedeGestionarEquipos && EstadoTorneo.Fixture != null)
{
    <div class="alert alert-warning mb-3">
        <span class="oi oi-warning" aria-hidden="true"></span>
        No se pueden editar ni eliminar equipos que participan en el fixture generado.
    </div>
}

<!-- Tabla de equipos -->
<div class="table-card mb-4">
    @if (_equipos.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">⚽</div>
            <div class="empty-state-title">No hay equipos registrados</div>
            <div class="empty-state-text">Agregá equipos manualmente o usá la opción de completar automáticamente.</div>
            @if (SesionServicio.PuedeGestionarEquipos)
            {
                <a href="/equipos/crear" class="btn btn-primary">
                    <span class="oi oi-plus" aria-hidden="true"></span> Agregar primer equipo
                </a>
            }
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Confederación</th>
                    <th>Ranking FIFA</th>
                    <th class="text-center">PJ</th>
                    <th class="text-center">GF</th>
                    <th class="text-center">GC</th>
                    <th class="text-center">DG</th>
                    <th class="text-center">Pts</th>
                    @if (SesionServicio.PuedeGestionarEquipos)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var (equipo, i) in _equipos.Select((e, i) => (e, i + 1)))
                {
                    var estadisticas = ObtenerEstadisticas(equipo);
                    <tr>
                        <td style="color:var(--text-muted); width:40px">@i</td>
                        <td style="font-weight:600">
                            <div style="display:flex; align-items:center; gap:8px;">
                                @if (!string.IsNullOrEmpty(equipo.Bandera))
                                {
                                    <img src="@equipo.Bandera" alt="Bandera" style="height:20px; border-radius:2px;" />
                                }
                                <span>@equipo.Nombre</span>
                            </div>
                        </td>
                        <td><span class="badge badge-muted">@equipo.Confederacion</span></td>
                        <td style="font-family:var(--font-heading); font-weight:700">@equipo.RankingFIFA</td>
                        <td class="text-center">@estadisticas.PartidosJugados</td>
                        <td class="text-center">@estadisticas.GolesAFavor</td>
                        <td class="text-center">@estadisticas.GolesEnContra</td>
                        <td class="text-center">@estadisticas.DiferenciaGoles</td>
                        <td class="text-center" style="font-weight:700">@estadisticas.Puntos</td>
                        @if (SesionServicio.PuedeGestionarEquipos)
                        {
                            var equipoBloqueadoPorFixture = EquipoParticipaEnFixture(equipo);
                            <td style="width:140px; text-align:right">
                                @if (equipoBloqueadoPorFixture)
                                {
                                    <button type="button"
                                            class="btn btn-success btn-sm"
                                            disabled
                                            title="No se puede editar un equipo que participa en el fixture generado.">
                                        <span class="oi oi-pencil" aria-hidden="true"></span>
                                    </button>
                                }
                                else
                                {
                                    <a href="/equipos/@equipo.Nombre/editar" class="btn btn-success btn-sm">
                                        <span class="oi oi-pencil" aria-hidden="true"></span>
                                    </a>
                                }
                                <button class="btn btn-danger btn-sm"
                                        disabled="@(EstadoTorneo.Fixture != null)"
                                        @onclick="() => PedirConfirmacion(equipo)">
                                    <span class="oi oi-trash" aria-hidden="true"></span>
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Completar equipos -->
@if (SesionServicio.PuedeGestionarEquipos && _equipos.Count < 48)
{
    <div style="max-width:460px;">
        <div class="table-card">
            <div class="table-card-header">
                <span class="table-card-title">Completar hasta 48</span>
                <span class="badge badge-muted">@_equipos.Count / 48</span>
            </div>
            <div style="padding:20px;">
                <p style="font-size:13px; color:var(--text-secondary); margin-bottom:14px;">
                    Genera equipos ficticios para completar todos los cupos respetando las restricciones por confederación.
                </p>
                <div class="form-group">
                    <label class="form-label">Semilla de generación automática</label>
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                        <input type="number"
                               class="form-control"
                               style="width:120px;"
                               min="0"
                               step="1"
                               value="@_semillaCompletar"
                               readonly
                               aria-readonly="true" />
                        <a href="/configuracion" style="font-size:12px; color:var(--text-muted); white-space:nowrap;">
                            <span class="oi oi-cog" aria-hidden="true"></span> Configurar
                        </a>
                    </div>
                    <span class="form-hint">La misma semilla genera siempre los mismos equipos y rankings ficticios. Se configura desde ConfiguraciÃ³n y no modifica equipos ya generados.</span>
                </div>
                @if (!string.IsNullOrEmpty(_mensajeCompletar))
                {
                    <div class="alert alert-info">@_mensajeCompletar</div>
                }
                <button class="btn btn-warning w-100" @onclick="Completar">
                    <span class="oi oi-cog" aria-hidden="true"></span>
                    Completar equipos ficticios
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Equipo> _equipos = new();
    private Equipo? _equipoAEliminar;
    private bool _confirmarEliminar;
    private string _mensajeCompletar = string.Empty;
    private string _errorCarga = string.Empty;
    private int _semillaCompletar;
    private Dictionary<string, EstadisticasEquipo> _estadisticasPorEquipo = new(StringComparer.OrdinalIgnoreCase);

    private static readonly Dictionary<Confederacion, int> CuposMaximos = new()
    {
        { Confederacion.UEFA,     16 }, { Confederacion.CAF,      9 },
        { Confederacion.CONCACAF, 7  }, { Confederacion.CONMEBOL, 7 },
        { Confederacion.AFC,      8  }, { Confederacion.OFC,      1 }
    };

    private Dictionary<Confederacion, (int registrados, int cupo)> _cuposPorConfederacion = new();

    protected override void OnInitialized()
    {
        if (!SesionServicio.HaySesion)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        CargarDatos();
    }

    private void CargarDatos()
    {
        _errorCarga = string.Empty;
        try
        {
            _equipos = ServicioEquipo.Buscar(_ => true);
            _cuposPorConfederacion = CuposMaximos.ToDictionary(
                kvp => kvp.Key,
                kvp => (_equipos.Count(e => e.Confederacion == kvp.Key), kvp.Value));
            _semillaCompletar = ServicioConfiguracionTorneo.ObtenerConfiguracionActual().SemillaCompletar;
            CargarEstadisticas();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
            _equipos = new();
            _cuposPorConfederacion = CuposMaximos.ToDictionary(
                kvp => kvp.Key,
                kvp => (0, kvp.Value));
            _estadisticasPorEquipo = new Dictionary<string, EstadisticasEquipo>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private void CargarEstadisticas()
    {
        _estadisticasPorEquipo = _equipos.ToDictionary(
            e => e.Nombre,
            _ => new EstadisticasEquipo(),
            StringComparer.OrdinalIgnoreCase);

        var partidosJugados = (EstadoTorneo.Fixture?.Partidos ?? Enumerable.Empty<Partido>())
            .Concat(EstadoTorneo.PartidosEliminatorios)
            .Where(p => p.EstaJugado());

        foreach (var partido in partidosJugados)
        {
            var golesLocal = partido.GolesLocal ?? 0;
            var golesVisitante = partido.GolesVisitante ?? 0;
            var sumaPuntos = partido.Fase == FaseTorneo.FaseDeGrupos;
            RegistrarPartido(partido.EquipoLocal, golesLocal, golesVisitante,
                sumaPuntos ? CalcularPuntos(golesLocal, golesVisitante) : 0);
            RegistrarPartido(partido.EquipoVisitante, golesVisitante, golesLocal,
                sumaPuntos ? CalcularPuntos(golesVisitante, golesLocal) : 0);
        }
    }

    private void RegistrarPartido(Equipo? equipo, int golesAFavor, int golesEnContra, int puntos)
    {
        if (equipo == null)
            return;

        if (!_estadisticasPorEquipo.TryGetValue(equipo.Nombre, out var estadisticas))
        {
            estadisticas = new EstadisticasEquipo();
            _estadisticasPorEquipo[equipo.Nombre] = estadisticas;
        }

        estadisticas.PartidosJugados++;
        estadisticas.GolesAFavor += golesAFavor;
        estadisticas.GolesEnContra += golesEnContra;
        estadisticas.Puntos += puntos;
    }

    private static int CalcularPuntos(int golesPropios, int golesRivales)
    {
        if (golesPropios > golesRivales)
            return 3;

        return golesPropios == golesRivales ? 1 : 0;
    }

    private EstadisticasEquipo ObtenerEstadisticas(Equipo equipo)
        => _estadisticasPorEquipo.TryGetValue(equipo.Nombre, out var estadisticas)
            ? estadisticas
            : new EstadisticasEquipo();

    private bool EquipoParticipaEnFixture(Equipo equipo)
    {
        if (EstadoTorneo.Fixture == null)
            return false;

        return EstadoTorneo.Fixture.Grupos
                   .SelectMany(g => g.Equipos)
                   .Any(e => EsMismoEquipo(e, equipo))
               || EstadoTorneo.Fixture.Partidos
                   .Any(p => EsMismoEquipo(p.EquipoLocal, equipo)
                             || EsMismoEquipo(p.EquipoVisitante, equipo))
               || EstadoTorneo.PartidosEliminatorios
                   .Any(p => EsMismoEquipo(p.EquipoLocal, equipo)
                             || EsMismoEquipo(p.EquipoVisitante, equipo));
    }

    private static bool EsMismoEquipo(Equipo? participante, Equipo equipo)
    {
        if (participante == null)
            return false;

        if (participante.Id > 0 && equipo.Id > 0)
            return participante.Id == equipo.Id;

        return string.Equals(participante.Nombre, equipo.Nombre, StringComparison.OrdinalIgnoreCase);
    }

    private void Reintentar()
    {
        CargarDatos();
    }

    private void PedirConfirmacion(Equipo equipo)
    {
        _equipoAEliminar = equipo;
        _confirmarEliminar = true;
    }

    private void ConfirmarEliminar()
    {
        if (_equipoAEliminar == null) return;
        try
        {
            ServicioEquipo.Eliminar(_equipoAEliminar, SesionServicio.UsuarioActual);
            Toast.Exito($"Equipo \"{_equipoAEliminar.Nombre}\" eliminado.");
            _equipoAEliminar = null;
            CargarDatos();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void Completar()
    {
        _semillaCompletar = ServicioConfiguracionTorneo.ObtenerConfiguracionActual().SemillaCompletar;

        if (_semillaCompletar < 0)
        {
            Toast.Error("La semilla de generación automática debe ser mayor o igual a cero.");
            return;
        }

        try
        {
            var generados = ServicioEquipo.CompletarEquipos(_semillaCompletar, SesionServicio.UsuarioActual);
            CargarDatos();
            _mensajeCompletar = generados.Count > 0
                ? $"Se generaron {generados.Count} equipos ficticios correctamente."
                : "Ya hay 48 equipos registrados.";
            if (generados.Count > 0) Toast.Exito(_mensajeCompletar);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private sealed class EstadisticasEquipo
    {
        public int PartidosJugados { get; set; }
        public int GolesAFavor { get; set; }
        public int GolesEnContra { get; set; }
        public int DiferenciaGoles => GolesAFavor - GolesEnContra;
        public int Puntos { get; set; }
    }
}
