@page "/partidos/{Id:int}/editar"
@inject ServicioPartido ServicioPartido
@inject ServicioEstadio ServicioEstadio
@inject ServicioIncidencia ServicioIncidencia
@inject ServicioPersistenciaFixture ServicioPersistenciaFixture
@inject EstadoTorneo EstadoTorneo
@inject ServicioOrquestadorPartido OrquestadorPartido
@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@inject ToastServicio Toast

<PageTitle>Editar partido — WorldCupPlanner 2026</PageTitle>

<PageHeader Titulo="Editar partido" UrlVolver="/fixture" TextoVolver="Volver al fixture" />

@if (_partido == null)
{
    <div class="alert alert-warning">Partido no encontrado.</div>
}
else
{
    <!-- Encabezado del partido -->
    <div class="glass-card" style="padding:20px; margin-bottom:24px; text-align:center;">
        <div style="display:flex; align-items:center; justify-content:center; gap:16px;">
            <div style="flex:1; text-align:right;">
                <span style="font-family:var(--font-heading); font-size:18px; font-weight:700;">
                    @_partido.EquipoLocal?.Nombre
                </span>
                @if (_partido.FueDefinidoPorPenales() && ReferenceEquals(_partido.GanadorPorPenales, _partido.EquipoLocal))
                {
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:rgb(251,146,60); margin-top:3px;">
                        Ganador por penales
                    </div>
                }
            </div>
            <div style="display:flex; align-items:center; gap:8px; padding:8px 16px; background:var(--bg-raised); border-radius:var(--radius);">
                @if (_partido.EstaJugado())
                {
                    <span class="score-box">@_partido.GolesLocal</span>
                    <span class="score-sep" style="font-size:16px">—</span>
                    <span class="score-box">@_partido.GolesVisitante</span>
                }
                else
                {
                    <span style="font-size:14px; color:var(--text-muted)">vs</span>
                }
            </div>
            <div style="flex:1; text-align:left;">
                <span style="font-family:var(--font-heading); font-size:18px; font-weight:700;">
                    @_partido.EquipoVisitante?.Nombre
                </span>
                @if (_partido.FueDefinidoPorPenales() && ReferenceEquals(_partido.GanadorPorPenales, _partido.EquipoVisitante))
                {
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:rgb(251,146,60); margin-top:3px;">
                        Ganador por penales
                    </div>
                }
            </div>
        </div>
        @if (_partido.Grupo != null)
        {
            <div style="margin-top:8px"><span class="badge badge-muted">Grupo @_partido.Grupo.Etiqueta</span></div>
        }
        else
        {
            <div style="margin-top:8px; display:flex; align-items:center; justify-content:center; gap:8px;">
                <span class="badge badge-blue">@_partido.Fase.ToEtiqueta()</span>
                @if (_partido.FueDefinidoPorPenales())
                {
                    <span class="badge badge-penalty">Definido por penales</span>
                }
            </div>
        }
    </div>

    @if (ServicioPartido.EsFaseBloqueada(_partido.Fase))
    {
        <div class="alert alert-warning">
            <span class="oi oi-warning" aria-hidden="true"></span>
            Este partido no se puede editar porque ya se generaron los cruces de la fase eliminatoria.
        </div>
        <a href="/fixture" class="btn btn-secondary">Volver al fixture</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">
                <span class="oi oi-warning" aria-hidden="true"></span> @_error
            </div>
        }

        @if (_partido.Grupo == null)
        {
            <div class="alert alert-info" style="font-size:13px;">
                <span class="oi oi-info" aria-hidden="true"></span>
                Partido de fase eliminatoria: si el resultado es empate al finalizar el tiempo reglamentario,
                el sistema asignará automáticamente un ganador por penales.
            </div>
        }

        <div class="form-section">
            <div class="form-group">
                <label class="form-label">Fecha y hora</label>
                <input type="datetime-local" class="form-control" @bind="_nuevaFecha" />
            </div>

            <div class="form-group">
                <label class="form-label">Estadio</label>
                <select class="form-select" @bind="_nombreEstadio">
                    @foreach (var estadio in _estadios)
                    {
                        <option value="@estadio.Nombre">@estadio.Nombre (@estadio.Ciudad)</option>
                    }
                </select>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="form-label">Goles — @_partido.EquipoLocal?.Nombre</label>
                        <input type="number" class="form-control" @bind="_golesLocal" min="0" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="form-label">Goles — @_partido.EquipoVisitante?.Nombre</label>
                        <input type="number" class="form-control" @bind="_golesVisitante" min="0" />
                    </div>
                </div>
            </div>

            <hr style="border-color: var(--border-subtle); margin: 20px 0;" />

            <div class="form-group">
                <label class="form-label">Tarjetas</label>

                @if (_incidencias.Any())
                {
                    <div style="margin-bottom: 12px;">
                        @foreach (var inc in _incidencias)
                        {
                            <div class="d-flex align-items-center gap-2" style="padding: 6px 0; border-bottom: 1px solid var(--border-subtle);">
                                <span class="badge @(inc is TarjetaRoja ? "badge-red" : "badge-gold")" style="min-width:70px; text-align:center;">
                                    @(inc is TarjetaRoja ? "Roja" : "Amarilla")
                                </span>
                                <span style="flex:1; font-size:14px;">@inc.Equipo?.Nombre</span>
                                <span style="font-size:13px; color:var(--text-secondary);">min. @inc.MinutoDelPartido</span>
                                <button class="btn btn-danger btn-sm" @onclick="() => EliminarTarjeta(inc.Id)">
                                    <span class="oi oi-trash" aria-hidden="true"></span>
                                </button>
                            </div>
                        }
                    </div>
                }

                <div class="row g-2 align-items-end">
                    <div class="col-sm-3">
                        <label class="form-label" style="font-size:13px;">Equipo</label>
                        <select class="form-select form-select-sm" @bind="_equipoTarjeta">
                            <option value="Local">@_partido.EquipoLocal?.Nombre (Local)</option>
                            <option value="Visitante">@_partido.EquipoVisitante?.Nombre (Visitante)</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label" style="font-size:13px;">Minuto</label>
                        <input type="number" class="form-control form-control-sm" @bind="_minutoTarjeta" min="1" max="90" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label" style="font-size:13px;">Tipo</label>
                        <select class="form-select form-select-sm" @bind="_tipoTarjeta">
                            <option value="Amarilla">Amarilla</option>
                            <option value="Roja">Roja</option>
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <button type="button" class="btn btn-secondary btn-sm w-100" @onclick="AgregarTarjeta">
                            <span class="oi oi-plus" aria-hidden="true"></span> Agregar tarjeta
                        </button>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-primary" @onclick="Guardar">
                    <span class="oi oi-check" aria-hidden="true"></span> Guardar
                </button>
                <a href="/fixture" class="btn btn-secondary">Cancelar</a>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private Partido? _partido;
    private List<Estadio> _estadios = new();
    private DateTime _nuevaFecha;
    private string _nombreEstadio = string.Empty;
    private int? _golesLocal;
    private int? _golesVisitante;
    private string _error = string.Empty;
    private List<Incidencia> _incidencias = new();
    private string _equipoTarjeta = "Local";
    private int _minutoTarjeta = 1;
    private TipoTarjeta _tipoTarjeta = TipoTarjeta.Amarilla;

    protected override void OnInitialized()
    {
        if (!SesionServicio.HaySesion)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!SesionServicio.PuedeEditarPartidos)
        {
            NavigationManager.NavigateTo("/fixture");
            return;
        }

        _estadios = ServicioEstadio.ObtenerEstadios();
        _partido  = ServicioPartido.BuscarPartidoPorId(Id);
        if (_partido != null)
        {
            _nuevaFecha    = _partido.Fecha;
            _nombreEstadio = _partido.Estadio?.Nombre ?? string.Empty;
            _golesLocal    = _partido.GolesLocal;
            _golesVisitante = _partido.GolesVisitante;
            _incidencias   = ServicioIncidencia.ObtenerIncidencias(Id);
        }
    }

    private void Guardar()
    {
        _error = string.Empty;
        try
        {
            if (_partido == null) return;
            var estadio = _estadios.First(e => e.Nombre == _nombreEstadio);
            OrquestadorPartido.GuardarCambiosPartido(
                _partido.Id,
                _nuevaFecha,
                estadio,
                _golesLocal,
                _golesVisitante,
                SesionServicio.UsuarioActual,
                EstadoTorneo);
            Toast.Exito("Partido actualizado correctamente.");
            NavigationManager.NavigateTo("/fixture");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void AgregarTarjeta()
    {
        if (_partido == null) return;
        _error = string.Empty;
        try
        {
            ServicioPersistenciaFixture.GuardarPartidos(new[] { _partido });
            var equipo = ServicioIncidencia.ResolverEquipoPorRol(_partido, _equipoTarjeta);
            ServicioIncidencia.AgregarTarjeta(_partido.Id, _tipoTarjeta, _minutoTarjeta, equipo);
            _incidencias = ServicioIncidencia.ObtenerIncidencias(_partido.Id);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void EliminarTarjeta(int id)
    {
        _error = string.Empty;
        try
        {
            ServicioIncidencia.EliminarIncidencia(id);
            _incidencias = ServicioIncidencia.ObtenerIncidencias(_partido!.Id);
        }
        catch (Exception ex) { _error = ex.Message; }
    }


}
