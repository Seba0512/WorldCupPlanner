@if (!string.IsNullOrEmpty(Contrasenia))
{
    <div class="password-requirements">
        <p class="requirements-label">La contraseña debe cumplir:</p>
        <ul class="requirements-list">
            <li class="@(ValidadorContrasenia.CumpleLongitud(Contrasenia) ? "req-ok" : "req-pending")">
                <span class="oi @(ValidadorContrasenia.CumpleLongitud(Contrasenia) ? "oi-check" : "oi-minus")" aria-hidden="true"></span>
                Mínimo 8 caracteres
            </li>
            <li class="@(ValidadorContrasenia.CumpleMayuscula(Contrasenia) ? "req-ok" : "req-pending")">
                <span class="oi @(ValidadorContrasenia.CumpleMayuscula(Contrasenia) ? "oi-check" : "oi-minus")" aria-hidden="true"></span>
                Al menos una mayúscula
            </li>
            <li class="@(ValidadorContrasenia.CumpleMinuscula(Contrasenia) ? "req-ok" : "req-pending")">
                <span class="oi @(ValidadorContrasenia.CumpleMinuscula(Contrasenia) ? "oi-check" : "oi-minus")" aria-hidden="true"></span>
                Al menos una minúscula
            </li>
            <li class="@(ValidadorContrasenia.CumpleNumero(Contrasenia) ? "req-ok" : "req-pending")">
                <span class="oi @(ValidadorContrasenia.CumpleNumero(Contrasenia) ? "oi-check" : "oi-minus")" aria-hidden="true"></span>
                Al menos un número
            </li>
            <li class="@(ValidadorContrasenia.CumpleEspecial(Contrasenia) ? "req-ok" : "req-pending")">
                <span class="oi @(ValidadorContrasenia.CumpleEspecial(Contrasenia) ? "oi-check" : "oi-minus")" aria-hidden="true"></span>
                Al menos un carácter especial (@@, #, $, ., !, &amp;, *, -, _, +, =, ?)
            </li>
        </ul>
    </div>
}

@code {
    [Parameter] public string Contrasenia { get; set; } = string.Empty;
}
