@inherits LayoutComponentBase
@inject SesionServicio SesionServicio

<PageTitle>WorldCupPlanner 2026</PageTitle>

<div class="app-shell">
    <NavMenu />

    <div class="main-wrapper">
        <header class="topbar">
            <span class="topbar-title">WorldCupPlanner 2026</span>
            @if (SesionServicio.HaySesion)
            {
                <div class="topbar-user-info">
                    <span class="topbar-user-name">
                        @SesionServicio.UsuarioActual!.Nombre @SesionServicio.UsuarioActual.Apellido
                    </span>
                    @if (SesionServicio.EsAdministrador)
                    {
                        <span class="topbar-role-badge">Admin</span>
                    }
                    else
                    {
                        <span class="topbar-role-badge editor">Editor</span>
                    }
                </div>
            }
        </header>

        <main class="main-content">
            <AppToast />
            @Body
        </main>
    </div>
</div>
