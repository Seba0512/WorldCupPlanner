@inject SesionServicio SesionServicio
@inject NavigationManager NavigationManager
@implements IDisposable

<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="sidebar-brand-icon">⚽</div>
        <div>
            <span class="sidebar-brand-text">WorldCupPlanner</span><br />
            <span class="sidebar-brand-year">2026</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        @if (SesionServicio.HaySesion)
        {
            <span class="sidebar-section-label">Principal</span>

            <NavLink class="sidebar-link" href="/" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span>
                Dashboard
            </NavLink>

            <NavLink class="sidebar-link" href="/fixture">
                <span class="oi oi-globe" aria-hidden="true"></span>
                Fixture
            </NavLink>

            <NavLink class="sidebar-link" href="/partidos">
                <span class="oi oi-list" aria-hidden="true"></span>
                Partidos
            </NavLink>

            @if (SesionServicio.EsAdministrador)
            {
                <span class="sidebar-section-label">Administración</span>

                <NavLink class="sidebar-link" href="/equipos">
                    <span class="oi oi-people" aria-hidden="true"></span>
                    Equipos
                </NavLink>

                <NavLink class="sidebar-link" href="/estadios">
                    <span class="oi oi-map-marker" aria-hidden="true"></span>
                    Estadios
                </NavLink>

                <NavLink class="sidebar-link" href="/usuarios">
                    <span class="oi oi-person" aria-hidden="true"></span>
                    Usuarios
                </NavLink>

                <NavLink class="sidebar-link" href="/auditoria">
                    <span class="oi oi-document" aria-hidden="true"></span>
                    Auditoría
                </NavLink>
            }
        }
    </nav>

    @if (SesionServicio.HaySesion)
    {
        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="user-avatar">@Iniciales</div>
                <div class="user-info">
                    <span class="user-name">@SesionServicio.UsuarioActual!.Nombre @SesionServicio.UsuarioActual.Apellido</span>
                    <span class="user-role">@(SesionServicio.EsAdministrador ? "Administrador" : "Editor")</span>
                </div>
                <button class="btn-logout" title="Cerrar sesión" @onclick="CerrarSesion">
                    <span class="oi oi-account-logout" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    }
</aside>

@code {
    private string Iniciales => SesionServicio.HaySesion
        ? $"{SesionServicio.UsuarioActual!.Nombre[0]}{SesionServicio.UsuarioActual.Apellido[0]}".ToUpper()
        : "??";

    protected override void OnInitialized()
    {
        SesionServicio.OnChange += StateHasChanged;
    }

    private void CerrarSesion()
    {
        SesionServicio.CerrarSesion();
        NavigationManager.NavigateTo("/login");
    }

    public void Dispose()
    {
        SesionServicio.OnChange -= StateHasChanged;
    }
}
